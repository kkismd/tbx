REM STTR1 device registry and damage lifecycle.
# 1 WARP ENGINES, 2 SHORT RANGE SENSORS, 3 LONG RANGE SENSORS,
# 4 PHASER CONTROL, 5 PHOTON TUBES, 6 DAMAGE CONTROL,
# 7 SHIELD CONTROL, 8 LIBRARY COMPUTER.

# Advance every damaged device one repair unit.  Positive values are kept:
# random improvement events intentionally may move a device above zero.
DEF REPAIR_DEVICES
  # I is the per-call device registry scan index.
  FOR I = 1 TO 8
    IF @DAMAGE[I] < 0
      LET @DAMAGE[I] = @DAMAGE[I] + 1
    ENDIF
  NEXT
END

# Print the fixed registry name for the explicit device index on the stack.
# The local reference reads that argument while DROP consumes it on every path.
DEF PRINT_DEVICE_NAME INDEX
  SELECT INDEX
  CASE 1
    PRINT "WARP ENGINES"
  CASE 2
    PRINT "SHORT RANGE SENSORS"
  CASE 3
    PRINT "LONG RANGE SENSORS"
  CASE 4
    PRINT "PHASER CONTROL"
  CASE 5
    PRINT "PHOTON TUBES"
  CASE 6
    PRINT "DAMAGE CONTROL"
  CASE 7
    PRINT "SHIELD CONTROL"
  CASE 8
    PRINT "LIBRARY COMPUTER"
  ENDSEL
  DROP
END

# Apply the original navigation event: a 20% event chooses one device,
# then worsens or improves it by one to five units without clamping.
DEF RANDOM_DEVICE_EVENT
  IF RND(5) <> 1
    RETURN
  ENDIF
  # I retains the selected device for both its damage update and notification.
  LET I = RND(8)
  IF RND(2) = 1
      # J is the short-lived damage change; I keeps the selected device.
      LET J = RND(5)
      LET @DAMAGE[I] = @DAMAGE[I] - J
      PRINT "DAMAGE CONTROL REPORT: "
      EVAL I
      PRINT_DEVICE_NAME
      PRINT " DAMAGED"
      CR
    ELSE
      LET J = RND(5)
      LET @DAMAGE[I] = @DAMAGE[I] + J
      EVAL I
      PRINT_DEVICE_NAME
      PRINT " STATE OF REPAIR IMPROVED"
      CR
  ENDIF
END

DEF NAVIGATION_DEVICE_EVENTS
  REPAIR_DEVICES
  RANDOM_DEVICE_EVENT
END

# Device 6 is the damage-control command itself.  It cannot report damage
# while damaged; the remaining device names and slots are the fixed registry.
DEF DAMAGE_CONTROL
  IF @DAMAGE[6] < 0
    PRINT "DAMAGE CONTROL IS NON-OPERATIONAL"
    CR
    RETURN
  ENDIF
  PRINT "DAMAGE REPORT"
  CR
  # I is the per-call report scan index.
  FOR I = 1 TO 8
    EVAL I
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[I]
    CR
  NEXT
END
