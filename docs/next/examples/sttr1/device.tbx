REM STTR1 device registry and damage lifecycle.
# 1 WARP ENGINES, 2 SHORT RANGE SENSORS, 3 LONG RANGE SENSORS,
# 4 PHASER CONTROL, 5 PHOTON TUBES, 6 DAMAGE CONTROL,
# 7 SHIELD CONTROL, 8 LIBRARY COMPUTER.

# Advance every damaged device one repair unit.  Positive values are kept:
# random improvement events intentionally may move a device above zero.
DEF REPAIR_DEVICES
  LET DEVICE_INDEX = 1
  WHILE DEVICE_INDEX <= 8
    IF @DAMAGE[DEVICE_INDEX] < 0
      LET @DAMAGE[DEVICE_INDEX] = @DAMAGE[DEVICE_INDEX] + 1
    ENDIF
    LET DEVICE_INDEX = DEVICE_INDEX + 1
  ENDWH
END

# Print the fixed registry name selected by DEVICE_INDEX.
DEF PRINT_DEVICE_NAME
  SELECT DEVICE_INDEX
  CASE 1
    PRINT "WARP ENGINES"
  CASE 2
    PRINT "SHORT RANGE SENSORS"
  CASE 3
    PRINT "LONG RANGE SENSORS"
  CASE 4
    PRINT "PHASER CONTROL"
  CASE 5
    PRINT "PHOTON TUBES"
  CASE 6
    PRINT "DAMAGE CONTROL"
  CASE 7
    PRINT "SHIELD CONTROL"
  CASE 8
    PRINT "LIBRARY COMPUTER"
  ENDSEL
END

# Apply the original navigation event: a 20% event chooses one device,
# then worsens or improves it by one to five units without clamping.
DEF RANDOM_DEVICE_EVENT
  IF RND(5) <> 1
    RETURN
  ENDIF
  LET DEVICE_INDEX = RND(8)
  IF RND(2) = 1
      # I is the short-lived device damage change.
      LET I = RND(5)
      LET @DAMAGE[DEVICE_INDEX] = @DAMAGE[DEVICE_INDEX] - I
      PRINT "DAMAGE CONTROL REPORT: "
      PRINT_DEVICE_NAME
      PRINT " DAMAGED"
      CR
    ELSE
      LET I = RND(5)
      LET @DAMAGE[DEVICE_INDEX] = @DAMAGE[DEVICE_INDEX] + I
      PRINT_DEVICE_NAME
      PRINT " STATE OF REPAIR IMPROVED"
      CR
  ENDIF
END

DEF NAVIGATION_DEVICE_EVENTS
  REPAIR_DEVICES
  RANDOM_DEVICE_EVENT
END

# Device 6 is the damage-control command itself.  It cannot report damage
# while damaged; the remaining device names and slots are the fixed registry.
DEF DAMAGE_CONTROL
  IF @DAMAGE[6] < 0
    PRINT "DAMAGE CONTROL IS NON-OPERATIONAL"
    CR
    RETURN
  ENDIF
  PRINT "DAMAGE REPORT"
  CR
    LET DEVICE_INDEX = 1
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[DEVICE_INDEX]
    CR
    LET DEVICE_INDEX = 2
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[DEVICE_INDEX]
    CR
    LET DEVICE_INDEX = 3
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[DEVICE_INDEX]
    CR
    LET DEVICE_INDEX = 4
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[DEVICE_INDEX]
    CR
    LET DEVICE_INDEX = 5
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[DEVICE_INDEX]
    CR
    LET DEVICE_INDEX = 6
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[DEVICE_INDEX]
    CR
    LET DEVICE_INDEX = 7
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[DEVICE_INDEX]
    CR
    LET DEVICE_INDEX = 8
    PRINT_DEVICE_NAME
    PRINT " ", @DAMAGE[DEVICE_INDEX]
    CR
END
