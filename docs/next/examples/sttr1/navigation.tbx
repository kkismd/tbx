DEF NAVIGATE
  LET NAVIGATION_VALID = 0
  WHILE NAVIGATION_VALID = 0
    PRINT "COURSE (0 CANCEL, 10-89):"
    CR
    IF INPUT?()
      LET COURSE = DUP()
      DROP
      IF COURSE = 0
        LET NAVIGATION_VALID = 1
      ELSIF COURSE >= 10 AND COURSE <= 89
        PRINT "WARP (0-80):"
        CR
        IF INPUT?()
          LET WARP = DUP()
          DROP
          IF WARP >= 0 AND WARP <= 80
            IF @DAMAGE[1] < 0 AND WARP > 2
              PRINT "WARP ENGINES ARE DAMAGED, MAXIMUM SPEED = WARP .2"
              CR
            ELSE
              LET NAVIGATION_VALID = 1
            ENDIF
          ELSE
            PRINT "WARP OUT OF RANGE"
            CR
          ENDIF
        ELSE
          DROP
          PRINT "WARP INPUT ERROR"
          CR
        ENDIF
      ELSE
        PRINT "COURSE OUT OF RANGE"
        CR
      ENDIF
    ELSE
      DROP
      PRINT "COURSE INPUT ERROR"
      CR
    ENDIF
  ENDWH

  IF COURSE <> 0
    LET COURSE_INDEX = COURSE / 10
    LET COURSE_FRACTION = COURSE % 10
    LET DIRECTION_X = (@COURSE_DX[COURSE_INDEX] * (10 - COURSE_FRACTION) + @COURSE_DX[COURSE_INDEX + 1] * COURSE_FRACTION) / 10
    LET DIRECTION_Y = (@COURSE_DY[COURSE_INDEX] * (10 - COURSE_FRACTION) + @COURSE_DY[COURSE_INDEX + 1] * COURSE_FRACTION) / 10
    LET WARP_STEPS = WARP * 8 / 10
    LET POSITION_X = ENT_SX * 10
    LET POSITION_Y = ENT_SY * 10
    LET START_POSITION_X = POSITION_X
    LET START_POSITION_Y = POSITION_Y
    LET QUADRANT_CROSSED = 0
    LET NAVIGATION_VALID = 0

    WHILE NAVIGATION_VALID < WARP_STEPS
    LET PREVIOUS_X = POSITION_X
    LET PREVIOUS_Y = POSITION_Y
    LET NEXT_X = POSITION_X + DIRECTION_X
    LET NEXT_Y = POSITION_Y + DIRECTION_Y

    IF NEXT_X >= 5 AND NEXT_X <= 84 AND NEXT_Y >= 5 AND NEXT_Y <= 84
      LET TARGET_SX = (NEXT_X + 5) / 10
      LET TARGET_SY = (NEXT_Y + 5) / 10
      LET TARGET_INDEX = (TARGET_SY - 1) * 8 + TARGET_SX
      IF @SECTOR[TARGET_INDEX] <> 0
        LET POSITION_X = PREVIOUS_X
        LET POSITION_Y = PREVIOUS_Y
        LET NAVIGATION_VALID = WARP_STEPS
      ELSE
        LET @SECTOR[(ENT_SY - 1) * 8 + ENT_SX] = 0
        LET POSITION_X = NEXT_X
        LET POSITION_Y = NEXT_Y
        LET ENT_SX = TARGET_SX
        LET ENT_SY = TARGET_SY
        LET @SECTOR[TARGET_INDEX] = 1
        LET NAVIGATION_VALID = NAVIGATION_VALID + 1
      ENDIF
    ELSE
      # Crossing follows the original program: calculate the final position
      # from the starting sector and the complete planned distance, then
      # build only the final quadrant.
      LET POSITION_X = START_POSITION_X + DIRECTION_X * WARP_STEPS
      LET POSITION_Y = START_POSITION_Y + DIRECTION_Y * WARP_STEPS
      WHILE POSITION_X < 5
        LET ENT_QX = ENT_QX - 1
        LET POSITION_X = POSITION_X + 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE POSITION_X >= 85
        LET ENT_QX = ENT_QX + 1
        LET POSITION_X = POSITION_X - 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE POSITION_Y < 5
        LET ENT_QY = ENT_QY - 1
        LET POSITION_Y = POSITION_Y + 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE POSITION_Y >= 85
        LET ENT_QY = ENT_QY + 1
        LET POSITION_Y = POSITION_Y - 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      LET ENT_SX = (POSITION_X + 5) / 10
      LET ENT_SY = (POSITION_Y + 5) / 10
      INIT_QUADRANT
      LET NAVIGATION_VALID = WARP_STEPS
    ENDIF
    ENDWH

    LET ENERGY = ENERGY - WARP_STEPS + 5
    IF QUADRANT_CROSSED <> 0 OR WARP >= 10
      LET STARDATE = STARDATE + 1
    ENDIF
  ENDIF
END


DEF PRINT_SHORT_SCAN
  IF @DAMAGE[2] < 0
    PRINT "SHORT RANGE SENSORS INOPERABLE"
    CR
  ELSE
    PRINT "SHORT RANGE SCAN"
    CR
    LET SECTOR_ROW = 1
    WHILE SECTOR_ROW <= 8
      LET SECTOR_COLUMN = 1
      WHILE SECTOR_COLUMN <= 8
        LET SECTOR_INDEX = (SECTOR_ROW - 1) * 8 + SECTOR_COLUMN
        IF @SECTOR[SECTOR_INDEX] = 0
          PRINT "."
        ELSIF @SECTOR[SECTOR_INDEX] = 1
          PRINT "P"
        ELSIF @SECTOR[SECTOR_INDEX] = 2
          PRINT "K"
        ELSIF @SECTOR[SECTOR_INDEX] = 3
          PRINT "B"
        ELSE
          PRINT "*"
        ENDIF
        LET SECTOR_COLUMN = SECTOR_COLUMN + 1
      ENDWH
      CR
      LET SECTOR_ROW = SECTOR_ROW + 1
    ENDWH
    PRINT "STATUS ", STARDATE, " ", ENT_QX, " ", ENT_QY, " ", ENT_SX, " ", ENT_SY, " ", ENERGY, " ", TORPEDOES, " ", SHIELDS
    CR
  ENDIF
END

DEF PRINT_LONG_SCAN
  IF @DAMAGE[3] < 0
    PRINT "LONG RANGE SENSORS INOPERABLE"
    CR
  ELSE
    PRINT "LONG RANGE SCAN"
    CR
    LET SECTOR_ROW = ENT_QY - 1
    WHILE SECTOR_ROW <= ENT_QY + 1
      LET SECTOR_COLUMN = ENT_QX - 1
      WHILE SECTOR_COLUMN <= ENT_QX + 1
        IF SECTOR_ROW < 1 OR SECTOR_ROW > 8 OR SECTOR_COLUMN < 1 OR SECTOR_COLUMN > 8
          PRINT "---"
        ELSE
          LET SUMMARY = @GALAXY[(SECTOR_ROW - 1) * 8 + SECTOR_COLUMN]
          PRINT SUMMARY, " "
          IF @DAMAGE[7] >= 0
            LET @CHART[(SECTOR_ROW - 1) * 8 + SECTOR_COLUMN] = SUMMARY
          ENDIF
        ENDIF
        LET SECTOR_COLUMN = SECTOR_COLUMN + 1
      ENDWH
      CR
      LET SECTOR_ROW = SECTOR_ROW + 1
    ENDWH
  ENDIF
END

