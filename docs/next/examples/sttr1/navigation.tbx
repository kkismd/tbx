# Print a quadrant summary as a fixed-width KBS value (Klingons/Bases/Stars).
DEF PRINT_KBS SUMMARY_VALUE
  IF SUMMARY_VALUE < 10
    PRINT "00"
  ELSIF SUMMARY_VALUE < 100
    PRINT "0"
  ENDIF
  PUTDEC SUMMARY_VALUE
  DROP
END

DEF NAVIGATE
  LET NAVIGATION_VALID = 0
  WHILE NAVIGATION_VALID = 0
    PRINT_COURSE_GUIDE
    PRINT "COURSE (0 CANCEL, 10-89):"
    CR
    IF INPUT?()
      LET COURSE = DUP()
      DROP
      IF COURSE = 0
        LET NAVIGATION_VALID = 1
      ELSIF COURSE >= 10 AND COURSE <= 89
        PRINT "WARP SCALE: INPUT 0-80 = WARP 0.0-8.0 (10=1.0); 10 WARP = ONE QUADRANT"
        CR
        PRINT "WARP (0-80):"
        CR
        IF INPUT?()
          LET WARP = DUP()
          DROP
          IF WARP >= 0 AND WARP <= 80
            # Device 1 is warp engines; damaged engines cap warp at .2.
            IF @DAMAGE[1] < 0 AND WARP > 2
              PRINT "WARP ENGINES ARE DAMAGED, MAXIMUM INPUT = 2 (WARP 0.2)"
              CR
            ELSE
              LET NAVIGATION_VALID = 1
            ENDIF
          ELSE
            PRINT "WARP OUT OF RANGE"
            CR
          ENDIF
        ELSE
          DROP
          PRINT "WARP INPUT ERROR"
          CR
        ENDIF
      ELSE
        PRINT "COURSE OUT OF RANGE"
        CR
      ENDIF
    ELSE
      DROP
      PRINT "COURSE INPUT ERROR"
      CR
    ENDIF
  ENDWH

  IF COURSE <> 0
    # A valid navigation course triggers the current quadrant's retaliation
    # before any navigation-side repair/event or movement is applied.
    KLINGON_ATTACK
    IF SHIELDS >= 0
    # Valid course/warp input reaches repair and random damage only here,
    # immediately before sector movement. Invalid input and cancel consume no
    # event RNG and do not advance repair state.
    NAVIGATION_DEVICE_EVENTS
    # I/J are the course index and interpolation fraction.
    LET I = COURSE / 10
    LET J = COURSE % 10
    # X/Y are the short-lived interpolated course vector.
    LET X = (@COURSE_DX[I] * (10 - J) + @COURSE_DX[I + 1] * J) / 10
    LET Y = (@COURSE_DY[I] * (10 - J) + @COURSE_DY[I + 1] * J) / 10
    LET WARP_STEPS = WARP * 8 / 10
    # M/N track the current fixed-point sector position.
    LET M = ENT_SX * 10
    LET N = ENT_SY * 10
    # P/Q preserve the starting position for quadrant crossing.
    LET P = M
    LET Q = N
    LET QUADRANT_CROSSED = 0
    LET NAVIGATION_VALID = 0

    WHILE NAVIGATION_VALID < WARP_STEPS
    # S/T retain the previous position for collision rollback.
    LET S = M
    LET T = N
    # U/V are the next fixed-point sector position.
    LET U = M + X
    LET V = N + Y

    IF U >= 5 AND U <= 84 AND V >= 5 AND V <= 84
      # O/L/K are the target x, target y, and sector index.
      LET O = (U + 5) / 10
      LET L = (V + 5) / 10
      LET K = (L - 1) * 8 + O
      IF @SECTOR[K] <> 0
        PRINT "WARP ENGINES SHUTDOWN AT SECTOR ", O, ",", L, " DUE TO OBSTACLE"
        CR
        LET M = S
        LET N = T
        LET NAVIGATION_VALID = WARP_STEPS
      ELSE
        LET @SECTOR[(ENT_SY - 1) * 8 + ENT_SX] = 0
        LET M = U
        LET N = V
        LET ENT_SX = O
        LET ENT_SY = L
        LET @SECTOR[K] = 1
        LET NAVIGATION_VALID = NAVIGATION_VALID + 1
      ENDIF
    ELSE
      # Crossing follows the original program: calculate the final position
      # from the starting sector and the complete planned distance, then
      # build only the final quadrant.
      LET M = P + X * WARP_STEPS
      LET N = Q + Y * WARP_STEPS
      WHILE M < 5
        LET ENT_QX = ENT_QX - 1
        LET M = M + 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE M >= 85
        LET ENT_QX = ENT_QX + 1
        LET M = M - 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE N < 5
        LET ENT_QY = ENT_QY - 1
        LET N = N + 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE N >= 85
        LET ENT_QY = ENT_QY + 1
        LET N = N - 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      LET ENT_SX = (M + 5) / 10
      LET ENT_SY = (N + 5) / 10
      INIT_QUADRANT
      LET NAVIGATION_VALID = WARP_STEPS
    ENDIF
    ENDWH

    LET ENERGY = ENERGY - WARP_STEPS + 5
    IF QUADRANT_CROSSED <> 0 OR WARP >= 10
      LET STARDATE = STARDATE + 1
    ENDIF
    CHECK_DOCKING
    ENDIF
  ENDIF
END


DEF PRINT_SHORT_SCAN
  CHECK_DOCKING
  # Device 2 is short range sensors.
  IF @DAMAGE[2] < 0
    PRINT "SHORT RANGE SENSORS INOPERABLE"
    CR
  ELSE
    PRINT "SHORT RANGE SCAN"
    CR
    LET SECTOR_ROW = 1
    WHILE SECTOR_ROW <= 8
      LET SECTOR_COLUMN = 1
      WHILE SECTOR_COLUMN <= 8
        LET SECTOR_INDEX = (SECTOR_ROW - 1) * 8 + SECTOR_COLUMN
        IF @SECTOR[SECTOR_INDEX] = 0
          PRINT "."
        ELSIF @SECTOR[SECTOR_INDEX] = 1
          PRINT "P"
        ELSIF @SECTOR[SECTOR_INDEX] = 2
          PRINT "K"
        ELSIF @SECTOR[SECTOR_INDEX] = 3
          PRINT "B"
        ELSE
          PRINT "*"
        ENDIF
        IF SECTOR_COLUMN < 8
          PRINT " "
        ENDIF
        LET SECTOR_COLUMN = SECTOR_COLUMN + 1
      ENDWH
      PRINT " | "
      SELECT SECTOR_ROW
      CASE 1
        PRINT "STARDATE ", STARDATE
      CASE 2
        PRINT "CONDITION "
        PRINT_CONDITION
      CASE 3
        PRINT "QUADRANT ", ENT_QX, ",", ENT_QY
      CASE 4
        PRINT "SECTOR ", ENT_SX, ",", ENT_SY
      CASE 5
        PRINT "ENERGY ", ENERGY
      CASE 6
        PRINT "TORPEDOES ", TORPEDOES
      CASE 7
        PRINT "SHIELDS ", SHIELDS
      CASE_ELSE
        IF DOCKED <> 0
          PRINT "DOCKED: ENERGY AND TORPEDOES REPLENISHED; SHIELDS RESET"
        ENDIF
      ENDSEL
      CR
      LET SECTOR_ROW = SECTOR_ROW + 1
    ENDWH
  ENDIF
END

DEF PRINT_LONG_SCAN
  # Device 3 is long range sensors.
  IF @DAMAGE[3] < 0
    PRINT "LONG RANGE SENSORS INOPERABLE"
    CR
  ELSE
    PRINT "LONG RANGE SCAN"
    CR
    PRINT "CENTER QUADRANT ", ENT_QX, ",", ENT_QY, " (CENTER OF 3X3 SCAN)"
    CR
    PRINT "KBS = KLINGONS / BASES / STARS"
    CR
    LET SECTOR_ROW = ENT_QY - 1
    WHILE SECTOR_ROW <= ENT_QY + 1
      LET SECTOR_COLUMN = ENT_QX - 1
      WHILE SECTOR_COLUMN <= ENT_QX + 1
        IF SECTOR_ROW < 1 OR SECTOR_ROW > 8 OR SECTOR_COLUMN < 1 OR SECTOR_COLUMN > 8
          PRINT "--- "
        ELSE
          LET SUMMARY = @GALAXY[(SECTOR_ROW - 1) * 8 + SECTOR_COLUMN]
          PRINT_KBS(SUMMARY)
          PRINT " "
          # Chart updates require device 8, the library computer.
          IF @DAMAGE[8] >= 0
            LET @CHART[(SECTOR_ROW - 1) * 8 + SECTOR_COLUMN] = SUMMARY
          ENDIF
        ENDIF
        LET SECTOR_COLUMN = SECTOR_COLUMN + 1
      ENDWH
      CR
      LET SECTOR_ROW = SECTOR_ROW + 1
    ENDWH
  ENDIF
END
