# Shared course guide used by navigation and photon torpedo input.
DEF PRINT_COURSE_GUIDE
  PRINT "COURSE SCALE: INPUT 10=1.0, 20=2.0, ..., 80=8.0"
  CR
  PRINT "DIRECTIONS: 10 E, 20 NE, 30 N, 40 NW, 50 W, 60 SW, 70 S, 80 SE"
  CR
END

# Return one interpolated component of the course vector (axis 1 = x, 2 = y).
DEF COURSE_COMPONENT COURSE_VALUE, AXIS
  LET I = COURSE_VALUE / 10
  LET J = COURSE_VALUE % 10
  IF AXIS = 1
    LET K = (@COURSE_DX[I] * (10 - J) + @COURSE_DX[I + 1] * J) / 10
  ELSE
    LET K = (@COURSE_DY[I] * (10 - J) + @COURSE_DY[I + 1] * J) / 10
  ENDIF
  DROP
  DROP
  EVAL K
END

# Return the integer square root of a non-negative value.  Combat uses this
# small TBX helper instead of adding a combat-specific VM primitive.
DEF ISQRT VALUE
  LET DAMAGE_VALUE = 0
  WHILE (DAMAGE_VALUE + 1) * (DAMAGE_VALUE + 1) <= VALUE
    LET DAMAGE_VALUE = DAMAGE_VALUE + 1
  ENDWH
  DROP
  EVAL DAMAGE_VALUE
END

# Return distance in tenths of a sector between Enterprise and Klingon INDEX.
DEF DIST_TO_KLINGON INDEX
  LET DAMAGE_VALUE = (@KLINGON_X[INDEX] - ENT_SX) * (@KLINGON_X[INDEX] - ENT_SX) + (@KLINGON_Y[INDEX] - ENT_SY) * (@KLINGON_Y[INDEX] - ENT_SY)
  LET DAMAGE_VALUE = ISQRT(DAMAGE_VALUE * 100)
  DROP
  EVAL DAMAGE_VALUE
END

# Calculate floor(ENERGY * ROLL * 10 / (DISTANCE10 * DIVISOR * 100)) without
# constructing an overflowing product.  ROLL is the 0..199 scale-100 value.
DEF COMBAT_DAMAGE ENERGY, ROLL, DISTANCE10, DIVISOR
  # I/J/K/L/M/N hold the short-lived checked-arithmetic intermediates.
  LET I = ENERGY / 100
  LET J = ENERGY % 100
  LET K = I * ROLL + J * ROLL / 100
  LET L = DISTANCE10 * DIVISOR
  LET M = K / L
  LET N = K % L
  LET DAMAGE_VALUE = M * 10 + N * 10 / L
  DROP
  DROP
  DROP
  DROP
  EVAL DAMAGE_VALUE
END

DEF DESTROY_KLINGON INDEX
  PRINT "KLINGON AT SECTOR ", @KLINGON_X[INDEX], ",", @KLINGON_Y[INDEX], " DESTROYED"
  CR
  # K is the short-lived sector index for the destroyed Klingon.
  LET K = (@KLINGON_Y[INDEX] - 1) * 8 + @KLINGON_X[INDEX]
  LET @SECTOR[K] = 0
  LET @KLINGON_E[INDEX] = 0
  LET KLINGONS_HERE = KLINGONS_HERE - 1
  LET KLINGONS_LEFT = KLINGONS_LEFT - 1
  IF ENT_QX >= 1 AND ENT_QX <= 8 AND ENT_QY >= 1 AND ENT_QY <= 8
    LET @GALAXY[(ENT_QY - 1) * 8 + ENT_QX] = KLINGONS_HERE * 100 + BASES_HERE * 10 + STARS_HERE
  ENDIF
  DROP
END


DEF KLINGON_ATTACK
  IF DOCKED <> 0
    IF KLINGONS_HERE > 0
      PRINT "STARBASE PROTECTION: KLINGON ATTACKS HAVE NO EFFECT"
      CR
    ENDIF
    RETURN
  ENDIF
  LET KLINGON_INDEX = 1
  WHILE KLINGON_INDEX <= 3
    IF @KLINGON_E[KLINGON_INDEX] > 0
      LET DAMAGE_DISTANCE = DIST_TO_KLINGON(KLINGON_INDEX)
      # I is the short-lived Klingon attack roll.
      LET I = RND(200) - 1
      LET DAMAGE_VALUE = COMBAT_DAMAGE(@KLINGON_E[KLINGON_INDEX], I, DAMAGE_DISTANCE, 1)
      LET SHIELDS = SHIELDS - DAMAGE_VALUE
      PRINT "KLINGON ATTACK FROM SECTOR ", @KLINGON_X[KLINGON_INDEX], ",", @KLINGON_Y[KLINGON_INDEX], ": DAMAGE ", DAMAGE_VALUE, " SHIELDS ", SHIELDS
      CR
    ENDIF
    LET KLINGON_INDEX = KLINGON_INDEX + 1
  ENDWH
END

DEF TORPEDO_RESOLVE_HIT TARGET_X, TARGET_Y, TARGET_SECTOR_INDEX
  IF TORPEDO_HIT = 2
    IF @KLINGON_E[1] > 0 AND @KLINGON_X[1] = TARGET_X AND @KLINGON_Y[1] = TARGET_Y
      PRINT "PHOTON TORPEDO HIT KLINGON AT SECTOR ", TARGET_X, ",", TARGET_Y
      CR
      DESTROY_KLINGON(1)
    ELSIF @KLINGON_E[2] > 0 AND @KLINGON_X[2] = TARGET_X AND @KLINGON_Y[2] = TARGET_Y
      PRINT "PHOTON TORPEDO HIT KLINGON AT SECTOR ", TARGET_X, ",", TARGET_Y
      CR
      DESTROY_KLINGON(2)
    ELSIF @KLINGON_E[3] > 0 AND @KLINGON_X[3] = TARGET_X AND @KLINGON_Y[3] = TARGET_Y
      PRINT "PHOTON TORPEDO HIT KLINGON AT SECTOR ", TARGET_X, ",", TARGET_Y
      CR
      DESTROY_KLINGON(3)
    ENDIF
  ELSIF TORPEDO_HIT = 3
    PRINT "PHOTON TORPEDO HIT STARBASE AT SECTOR ", TARGET_X, ",", TARGET_Y, "; STARBASE DESTROYED"
    CR
    LET @SECTOR[TARGET_SECTOR_INDEX] = 0
    LET BASES_HERE = BASES_HERE - 1
    LET BASES_LEFT = BASES_LEFT - 1
    IF ENT_QX >= 1 AND ENT_QX <= 8 AND ENT_QY >= 1 AND ENT_QY <= 8
      LET @GALAXY[(ENT_QY - 1) * 8 + ENT_QX] = KLINGONS_HERE * 100 + BASES_HERE * 10 + STARS_HERE
    ENDIF
  ELSIF TORPEDO_HIT = 4
    PRINT "PHOTON TORPEDO HIT STAR AT SECTOR ", TARGET_X, ",", TARGET_Y
    CR
  ENDIF
  DROP
  DROP
  DROP
END

DEF TORPEDO_FLIGHT
      # X/Y are the short-lived interpolated torpedo vector.
      LET X = COURSE_COMPONENT(COURSE, 1)
      LET Y = COURSE_COMPONENT(COURSE, 2)
      # M/N track the torpedo's fixed-point sector position.
      LET M = ENT_SX * 10
      LET N = ENT_SY * 10
      LET TORPEDO_ACTIVE = 1
      LET TORPEDO_HIT = 0

      WHILE TORPEDO_ACTIVE <> 0
        LET M = M + X
        LET N = N + Y
        IF M < 5 OR M > 84 OR N < 5 OR N > 84
          LET TORPEDO_ACTIVE = 0
        ELSE
          # I/L/K are the target x, target y, and sector index.
          LET I = (M + 5) / 10
          LET L = (N + 5) / 10
          LET K = (L - 1) * 8 + I
          IF @SECTOR[K] <> 0
            LET TORPEDO_ACTIVE = 0
            LET TORPEDO_HIT = @SECTOR[K]
            TORPEDO_RESOLVE_HIT I, L, K
          ENDIF
        ENDIF
      ENDWH
      IF TORPEDO_HIT = 0
        PRINT "PHOTON TORPEDO MISSED"
        CR
      ENDIF
END

DEF PHOTON_TORPEDO
  # Device 5 is photon tubes.
  IF @DAMAGE[5] < 0
    PRINT "PHOTON TUBES ARE DAMAGED"
    CR
    RETURN
  ENDIF
  IF TORPEDOES <= 0
    PRINT "NO PHOTON TORPEDOES LEFT"
    CR
    RETURN
  ENDIF
  LET TORPEDO_VALID = 0
  WHILE TORPEDO_VALID = 0
      PRINT_COURSE_GUIDE
      PRINT "COURSE (0 CANCEL, 10-89):"
      CR
      IF INPUT?()
        LET COURSE = DUP()
        DROP
        IF COURSE = 0
          LET TORPEDO_VALID = 1
          RETURN
        ELSIF COURSE >= 10 AND COURSE <= 89
          LET TORPEDO_VALID = 1
        ELSE
          PRINT "COURSE OUT OF RANGE"
          CR
        ENDIF
      ELSE
        DROP
        PRINT "COURSE INPUT ERROR"
        CR
      ENDIF
    ENDWH

      LET TORPEDOES = TORPEDOES - 1
      PRINT "PHOTON TORPEDO FIRED; TORPEDOES REMAINING: ", TORPEDOES
      CR
      TORPEDO_FLIGHT
      KLINGON_ATTACK
END


DEF PHASER
  IF KLINGONS_HERE = 0
    PRINT "NO KLINGONS IN THIS QUADRANT"
    CR
    RETURN
  ENDIF
  # Device 4 is phaser control.
  IF @DAMAGE[4] < 0
    PRINT "PHASER CONTROL IS NON-OPERATIONAL"
    CR
    RETURN
  ENDIF
  LET PHASER_ENERGY = 0
  LET PHASER_VALID = 0
  WHILE PHASER_VALID = 0
      PRINT "PHASER ENERGY AVAILABLE: ", ENERGY
      CR
      PRINT "PHASER ENERGY:"
      CR
      IF INPUT?()
        LET PHASER_ENERGY = DUP()
        DROP
        IF PHASER_ENERGY <= 0
          LET PHASER_ENERGY = 0
          LET PHASER_VALID = 1
          RETURN
        ELSIF PHASER_ENERGY > ENERGY
          PRINT "ENERGY EXCEEDED"
          CR
          LET PHASER_ENERGY = 0
        ELSE
          LET PHASER_VALID = 1
        ENDIF
      ELSE
        DROP
        PRINT "PHASER INPUT ERROR"
        CR
      ENDIF
    ENDWH

  LET ENERGY = ENERGY - PHASER_ENERGY
  IF @DAMAGE[8] < 0
    PRINT "LIBRARY COMPUTER DAMAGED: PHASER ACCURACY REDUCED"
    CR
  ENDIF
  KLINGON_ATTACK
  IF SHIELDS >= 0
      # Phaser accuracy is reduced by the library computer (device 8), while
      # shield control remains device 7.
      IF @DAMAGE[8] < 0
        # I is the short-lived phaser accuracy roll.
        LET I = RND(100) - 1
        LET PHASER_ENERGY = (PHASER_ENERGY / 100) * I + (PHASER_ENERGY % 100) * I / 100
      ENDIF
      LET KLINGON_INDEX = 1
      WHILE KLINGON_INDEX <= 3
        IF @KLINGON_E[KLINGON_INDEX] > 0
          LET DAMAGE_DISTANCE = DIST_TO_KLINGON(KLINGON_INDEX)
          LET I = RND(200) - 1
          # J is the short-lived damage returned by COMBAT_DAMAGE.
          LET J = COMBAT_DAMAGE(PHASER_ENERGY, I, DAMAGE_DISTANCE, KLINGONS_HERE)
          LET @KLINGON_E[KLINGON_INDEX] = @KLINGON_E[KLINGON_INDEX] - J
          PRINT "PHASER HIT KLINGON AT SECTOR ", @KLINGON_X[KLINGON_INDEX], ",", @KLINGON_Y[KLINGON_INDEX], ": DAMAGE ", J, " ENERGY ", @KLINGON_E[KLINGON_INDEX]
          CR
          IF @KLINGON_E[KLINGON_INDEX] <= 0
            DESTROY_KLINGON(KLINGON_INDEX)
          ENDIF
        ENDIF
        LET KLINGON_INDEX = KLINGON_INDEX + 1
      ENDWH
  ENDIF
END
