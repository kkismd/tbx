# Return the integer square root of a non-negative value.  Combat uses this
# small TBX helper instead of adding a combat-specific VM primitive.
DEF ISQRT VALUE
  LET DAMAGE_VALUE = 0
  WHILE (DAMAGE_VALUE + 1) * (DAMAGE_VALUE + 1) <= VALUE
    LET DAMAGE_VALUE = DAMAGE_VALUE + 1
  ENDWH
  DROP
  EVAL DAMAGE_VALUE
END

# Return distance in tenths of a sector between Enterprise and Klingon INDEX.
DEF DIST_TO_KLINGON INDEX
  LET DAMAGE_VALUE = (@KLINGON_X[INDEX] - ENT_SX) * (@KLINGON_X[INDEX] - ENT_SX) + (@KLINGON_Y[INDEX] - ENT_SY) * (@KLINGON_Y[INDEX] - ENT_SY)
  LET DAMAGE_VALUE = ISQRT(DAMAGE_VALUE * 100)
  DROP
  EVAL DAMAGE_VALUE
END

# Calculate floor(ENERGY * ROLL * 10 / (DISTANCE10 * DIVISOR * 100)) without
# constructing an overflowing product.  ROLL is the 0..199 scale-100 value.
DEF COMBAT_DAMAGE ENERGY, ROLL, DISTANCE10, DIVISOR
  LET DAMAGE_ENERGY_QUOTIENT = ENERGY / 100
  LET DAMAGE_ENERGY_REMAINDER = ENERGY % 100
  LET DAMAGE_PRODUCT = DAMAGE_ENERGY_QUOTIENT * ROLL + DAMAGE_ENERGY_REMAINDER * ROLL / 100
  LET DAMAGE_DENOMINATOR = DISTANCE10 * DIVISOR
  LET DAMAGE_QUOTIENT = DAMAGE_PRODUCT / DAMAGE_DENOMINATOR
  LET DAMAGE_REMAINDER = DAMAGE_PRODUCT % DAMAGE_DENOMINATOR
  LET DAMAGE_VALUE = DAMAGE_QUOTIENT * 10 + DAMAGE_REMAINDER * 10 / DAMAGE_DENOMINATOR
  DROP
  DROP
  DROP
  DROP
  EVAL DAMAGE_VALUE
END

DEF DESTROY_KLINGON INDEX
  LET DAMAGE_INDEX = (@KLINGON_Y[INDEX] - 1) * 8 + @KLINGON_X[INDEX]
  LET @SECTOR[DAMAGE_INDEX] = 0
  LET @KLINGON_E[INDEX] = 0
  LET KLINGONS_HERE = KLINGONS_HERE - 1
  LET KLINGONS_LEFT = KLINGONS_LEFT - 1
  IF ENT_QX >= 1 AND ENT_QX <= 8 AND ENT_QY >= 1 AND ENT_QY <= 8
    LET @GALAXY[(ENT_QY - 1) * 8 + ENT_QX] = KLINGONS_HERE * 100 + BASES_HERE * 10 + STARS_HERE
  ENDIF
  DROP
END


DEF KLINGON_ATTACK
  IF DOCKED = 0
    LET KLINGON_INDEX = 1
    WHILE KLINGON_INDEX <= 3
      IF @KLINGON_E[KLINGON_INDEX] > 0
        LET DAMAGE_DISTANCE = DIST_TO_KLINGON(KLINGON_INDEX)
        LET DAMAGE_ROLL = RND(200) - 1
        LET DAMAGE_VALUE = COMBAT_DAMAGE(@KLINGON_E[KLINGON_INDEX], DAMAGE_ROLL, DAMAGE_DISTANCE, 1)
        LET SHIELDS = SHIELDS - DAMAGE_VALUE
      ENDIF
      LET KLINGON_INDEX = KLINGON_INDEX + 1
    ENDWH
  ENDIF
END

DEF PHOTON_TORPEDO
  # Device 5 is photon tubes.
  IF @DAMAGE[5] < 0
    PRINT "PHOTON TUBES ARE DAMAGED"
    CR
  ELSIF TORPEDOES <= 0
    PRINT "NO PHOTON TORPEDOES LEFT"
    CR
  ELSE
    LET TORPEDO_VALID = 0
    WHILE TORPEDO_VALID = 0
      PRINT_COURSE_GUIDE
      PRINT "COURSE (0 CANCEL, 10-89):"
      CR
      IF INPUT?()
        LET COURSE = DUP()
        DROP
        IF COURSE = 0
          LET TORPEDO_VALID = 1
        ELSIF COURSE >= 10 AND COURSE <= 89
          LET TORPEDO_VALID = 1
        ELSE
          PRINT "COURSE OUT OF RANGE"
          CR
        ENDIF
      ELSE
        DROP
        PRINT "COURSE INPUT ERROR"
        CR
      ENDIF
    ENDWH

    IF COURSE <> 0
      LET COURSE_INDEX = COURSE / 10
      LET COURSE_FRACTION = COURSE % 10
      LET DIRECTION_X = (@COURSE_DX[COURSE_INDEX] * (10 - COURSE_FRACTION) + @COURSE_DX[COURSE_INDEX + 1] * COURSE_FRACTION) / 10
      LET DIRECTION_Y = (@COURSE_DY[COURSE_INDEX] * (10 - COURSE_FRACTION) + @COURSE_DY[COURSE_INDEX + 1] * COURSE_FRACTION) / 10
      LET TORPEDOES = TORPEDOES - 1
      LET POSITION_X = ENT_SX * 10
      LET POSITION_Y = ENT_SY * 10
      LET TORPEDO_ACTIVE = 1
      LET TORPEDO_HIT = 0

      WHILE TORPEDO_ACTIVE <> 0
        LET POSITION_X = POSITION_X + DIRECTION_X
        LET POSITION_Y = POSITION_Y + DIRECTION_Y
        IF POSITION_X < 5 OR POSITION_X > 84 OR POSITION_Y < 5 OR POSITION_Y > 84
          LET TORPEDO_ACTIVE = 0
        ELSE
          LET TARGET_SX = (POSITION_X + 5) / 10
          LET TARGET_SY = (POSITION_Y + 5) / 10
          LET TARGET_INDEX = (TARGET_SY - 1) * 8 + TARGET_SX
          IF @SECTOR[TARGET_INDEX] <> 0
            LET TORPEDO_ACTIVE = 0
            LET TORPEDO_HIT = @SECTOR[TARGET_INDEX]
            IF TORPEDO_HIT = 2
              IF @KLINGON_E[1] > 0 AND @KLINGON_X[1] = TARGET_SX AND @KLINGON_Y[1] = TARGET_SY
                DESTROY_KLINGON(1)
              ELSIF @KLINGON_E[2] > 0 AND @KLINGON_X[2] = TARGET_SX AND @KLINGON_Y[2] = TARGET_SY
                DESTROY_KLINGON(2)
              ELSIF @KLINGON_E[3] > 0 AND @KLINGON_X[3] = TARGET_SX AND @KLINGON_Y[3] = TARGET_SY
                DESTROY_KLINGON(3)
              ENDIF
            ELSIF TORPEDO_HIT = 3
              LET @SECTOR[TARGET_INDEX] = 0
              LET BASES_HERE = BASES_HERE - 1
              LET BASES_LEFT = BASES_LEFT - 1
              IF ENT_QX >= 1 AND ENT_QX <= 8 AND ENT_QY >= 1 AND ENT_QY <= 8
                LET @GALAXY[(ENT_QY - 1) * 8 + ENT_QX] = KLINGONS_HERE * 100 + BASES_HERE * 10 + STARS_HERE
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDWH
      KLINGON_ATTACK
    ENDIF
  ENDIF
END


DEF PHASER
  IF KLINGONS_HERE = 0
    PRINT "NO KLINGONS IN THIS QUADRANT"
    CR
  # Device 4 is phaser control.
  ELSIF @DAMAGE[4] < 0
    PRINT "PHASER CONTROL IS NON-OPERATIONAL"
    CR
  ELSE
    LET PHASER_ENERGY = 0
    LET PHASER_VALID = 0
    WHILE PHASER_VALID = 0
      PRINT "PHASER ENERGY:"
      CR
      IF INPUT?()
        LET PHASER_ENERGY = DUP()
        DROP
        IF PHASER_ENERGY <= 0
          LET PHASER_ENERGY = 0
          LET PHASER_VALID = 1
        ELSIF PHASER_ENERGY > ENERGY
          PRINT "ENERGY EXCEEDED"
          CR
          LET PHASER_ENERGY = 0
        ELSE
          LET PHASER_VALID = 1
        ENDIF
      ELSE
        DROP
        PRINT "PHASER INPUT ERROR"
        CR
      ENDIF
    ENDWH

    IF PHASER_ENERGY > 0
      LET ENERGY = ENERGY - PHASER_ENERGY
      KLINGON_ATTACK
    ENDIF
    IF PHASER_ENERGY > 0 AND SHIELDS >= 0
      # Phaser accuracy is reduced by the library computer (device 8), while
      # shield control remains device 7.
      IF @DAMAGE[8] < 0
        LET DAMAGE_ROLL = RND(100) - 1
        LET PHASER_ENERGY = (PHASER_ENERGY / 100) * DAMAGE_ROLL + (PHASER_ENERGY % 100) * DAMAGE_ROLL / 100
      ENDIF
      LET KLINGON_INDEX = 1
      WHILE KLINGON_INDEX <= 3
        IF @KLINGON_E[KLINGON_INDEX] > 0
          LET DAMAGE_DISTANCE = DIST_TO_KLINGON(KLINGON_INDEX)
          LET DAMAGE_ROLL = RND(200) - 1
          LET PHASER_DAMAGE = COMBAT_DAMAGE(PHASER_ENERGY, DAMAGE_ROLL, DAMAGE_DISTANCE, KLINGONS_HERE)
          LET @KLINGON_E[KLINGON_INDEX] = @KLINGON_E[KLINGON_INDEX] - PHASER_DAMAGE
          IF @KLINGON_E[KLINGON_INDEX] <= 0
            DESTROY_KLINGON(KLINGON_INDEX)
          ENDIF
        ENDIF
        LET KLINGON_INDEX = KLINGON_INDEX + 1
      ENDWH
    ENDIF
  ENDIF
END
