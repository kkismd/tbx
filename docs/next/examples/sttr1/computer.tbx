REM STTR1 library computer command.

# Convert the relative position of a Klingon into the existing 10..80 course
# scale.  The scale uses the same cardinal and diagonal directions as
# navigation and photon torpedoes; only the signs are needed for a report.
DEF KLINGON_COURSE INDEX
  LET COMPUTER_DX = @KLINGON_X[INDEX] - ENT_SX
  LET COMPUTER_DY = @KLINGON_Y[INDEX] - ENT_SY
  IF COMPUTER_DX > 0 AND COMPUTER_DY = 0
    LET COMPUTER_DIRECTION = 10
  ELSIF COMPUTER_DX > 0 AND COMPUTER_DY < 0
    LET COMPUTER_DIRECTION = 20
  ELSIF COMPUTER_DX = 0 AND COMPUTER_DY < 0
    LET COMPUTER_DIRECTION = 30
  ELSIF COMPUTER_DX < 0 AND COMPUTER_DY < 0
    LET COMPUTER_DIRECTION = 40
  ELSIF COMPUTER_DX < 0 AND COMPUTER_DY = 0
    LET COMPUTER_DIRECTION = 50
  ELSIF COMPUTER_DX < 0 AND COMPUTER_DY > 0
    LET COMPUTER_DIRECTION = 60
  ELSIF COMPUTER_DX = 0 AND COMPUTER_DY > 0
    LET COMPUTER_DIRECTION = 70
  ELSIF COMPUTER_DX > 0 AND COMPUTER_DY > 0
    LET COMPUTER_DIRECTION = 80
  ELSE
    LET COMPUTER_DIRECTION = 0
  ENDIF
  DROP
  EVAL COMPUTER_DIRECTION
END

DEF PRINT_CHART
  PRINT "GALACTIC CHART"
  CR
  LET SECTOR_ROW = 1
  WHILE SECTOR_ROW <= 8
    LET SECTOR_COLUMN = 1
    WHILE SECTOR_COLUMN <= 8
      LET SECTOR_INDEX = (SECTOR_ROW - 1) * 8 + SECTOR_COLUMN
      IF @CHART[SECTOR_INDEX] = 0
        PRINT "--- "
      ELSE
        PRINT @CHART[SECTOR_INDEX], " "
      ENDIF
      LET SECTOR_COLUMN = SECTOR_COLUMN + 1
    ENDWH
    CR
    LET SECTOR_ROW = SECTOR_ROW + 1
  ENDWH
END

DEF PRINT_COMPUTER_STATUS
  PRINT "KLINGONS_LEFT ", KLINGONS_LEFT
  CR
  PRINT "DEADLINE - STARDATE ", DEADLINE - STARDATE
  CR
  PRINT "BASES_LEFT ", BASES_LEFT
  CR
  DAMAGE_CONTROL
END

DEF PRINT_KLINGON_REPORT
  IF KLINGONS_HERE = 0
    PRINT "NO KLINGONS IN THIS QUADRANT"
    CR
  ELSE
    LET KLINGON_INDEX = 1
    WHILE KLINGON_INDEX <= 3
      IF @KLINGON_E[KLINGON_INDEX] > 0
        LET COMPUTER_DIRECTION = KLINGON_COURSE(KLINGON_INDEX)
        LET DAMAGE_DISTANCE = DIST_TO_KLINGON(KLINGON_INDEX)
        PRINT "KLINGON ", KLINGON_INDEX, " COURSE ", COMPUTER_DIRECTION, " DISTANCE ", DAMAGE_DISTANCE
        CR
      ENDIF
      LET KLINGON_INDEX = KLINGON_INDEX + 1
    ENDWH
  ENDIF
END

DEF COMPUTER
  IF @DAMAGE[8] < 0
    PRINT "LIBRARY COMPUTER IS NON-OPERATIONAL"
    CR
  ELSE
    LET COMPUTER_OPTION = -1
    WHILE COMPUTER_OPTION < 0 OR COMPUTER_OPTION > 2
      PRINT "COMPUTER OPTION (0 CHART, 1 STATUS, 2 KLINGONS):"
      CR
      IF INPUT?()
        LET COMPUTER_OPTION = DUP()
        DROP
        IF COMPUTER_OPTION < 0 OR COMPUTER_OPTION > 2
          PRINT "COMPUTER OPTION OUT OF RANGE"
          CR
        ENDIF
      ELSE
        DROP
        PRINT "COMPUTER INPUT ERROR"
        CR
      ENDIF
    ENDWH

    IF COMPUTER_OPTION = 0
      PRINT_CHART
    ELSIF COMPUTER_OPTION = 1
      PRINT_COMPUTER_STATUS
    ELSE
      PRINT_KLINGON_REPORT
    ENDIF
  ENDIF
END
