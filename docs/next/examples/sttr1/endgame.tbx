REM STTR1 endgame checks and mission summary.

DEF PRINT_MISSION_SUMMARY
  PRINT "MISSION SUMMARY"
  CR
  IF GAME_RESULT = 1
    PRINT "RESULT VICTORY"
    CR
    PRINT "ELAPSED ", ELAPSED
    CR
    PRINT "EFFICIENCY ", EFFICIENCY
    CR
  ELSE
    PRINT "RESULT DEFEAT"
    CR
    IF END_REASON = 1
      PRINT "REASON TIMEOUT"
      CR
    ELSIF END_REASON = 2
      PRINT "REASON DESTROYED"
      CR
    ELSE
      PRINT "REASON DEAD-IN-SPACE"
      CR
    ENDIF
    PRINT "KLINGONS REMAINING ", KLINGONS_LEFT
    CR
  ENDIF
END

DEF CHECK_ENDGAME
  IF GAME_RESULT = 0
    IF KLINGONS_LEFT <= 0
      LET GAME_RESULT = 1
      LET END_REASON = 0
    ELSIF STARDATE > DEADLINE
      LET GAME_RESULT = 2
      LET END_REASON = 1
    ELSIF KLINGONS_HERE <= 0 AND ENERGY <= 0 AND SHIELDS < 1
      LET GAME_RESULT = 2
      LET END_REASON = 3
    ELSIF SHIELDS < 0
      LET GAME_RESULT = 2
      LET END_REASON = 2
    ENDIF

    IF GAME_RESULT <> 0
      LET ELAPSED = STARDATE - START_STARDATE
      IF ELAPSED <= 0
        LET ELAPSED = 1
      ENDIF
      IF GAME_RESULT = 1
        # Add one 1000-point contribution at a time so no product exceeds i16.
        LET EFFICIENCY = 0
        LET EFFICIENCY_INDEX = 1
        LET EFFICIENCY_REMAINDER = 0
        LET EFFICIENCY_CAPPED = 0
        WHILE EFFICIENCY_INDEX <= KLINGONS_INITIAL AND EFFICIENCY_CAPPED = 0
          # Avoid remainder + 1000 overflow when elapsed is near i16::MAX.
          IF ELAPSED > 1000 AND EFFICIENCY_REMAINDER >= ELAPSED - 1000
            LET EFFICIENCY_REMAINDER = EFFICIENCY_REMAINDER - ELAPSED + 1000
            LET EFFICIENCY_INCREMENT = 1
          ELSE
            LET EFFICIENCY_REMAINDER = EFFICIENCY_REMAINDER + 1000
            LET EFFICIENCY_INCREMENT = EFFICIENCY_REMAINDER / ELAPSED
            LET EFFICIENCY_REMAINDER = EFFICIENCY_REMAINDER % ELAPSED
          ENDIF
          IF EFFICIENCY > 32767 - EFFICIENCY_INCREMENT
            LET EFFICIENCY = 32767
            LET EFFICIENCY_CAPPED = 1
          ELSE
            LET EFFICIENCY = EFFICIENCY + EFFICIENCY_INCREMENT
          ENDIF
          LET EFFICIENCY_INDEX = EFFICIENCY_INDEX + 1
        ENDWH
      ELSE
        LET EFFICIENCY = 0
      ENDIF
      PRINT_MISSION_SUMMARY
    ENDIF
  ENDIF
END
