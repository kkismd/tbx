REM STTR1 mission initialization and interactive command loop.

DEF PRINT_COMMAND_MENU
  PRINT "COMMANDS (0-7)"
  CR
  PRINT "0 NAVIGATE"
  CR
  PRINT "1 SHORT RANGE SCAN"
  CR
  PRINT "2 LONG RANGE SCAN"
  CR
  PRINT "3 PHASER"
  CR
  PRINT "4 PHOTON TORPEDO"
  CR
  PRINT "5 SHIELD CONTROL"
  CR
  PRINT "6 DAMAGE CONTROL"
  CR
  PRINT "7 COMPUTER"
  CR
END

DEF INIT_MISSION
  LET START_STARDATE = (RND(20) + 19) * 100
  LET STARDATE = START_STARDATE
  LET MISSION_DURATION = 30
  LET DEADLINE = START_STARDATE + MISSION_DURATION
  LET MAX_ENERGY = 3000
  LET ENERGY = MAX_ENERGY
  LET MAX_TORPEDOES = 10
  LET TORPEDOES = MAX_TORPEDOES
  LET SHIELDS = 0
  LET GAME_RESULT = 0
  LET END_REASON = 0
  LET DOCKED = 0
  LET KLINGON_INIT_ENERGY = 200
  LET ENT_QX = RND(8)
  LET ENT_QY = RND(8)
  LET ENT_SX = RND(8)
  LET ENT_SY = RND(8)

  PACK @COURSE_DX = 10, 7, 0, -7, -10, -7, 0, 7, 10
  PACK @COURSE_DY = 0, -7, -10, -7, 0, 7, 10, 7, 0

  LET KLINGONS_LEFT = 0
  LET BASES_LEFT = 0
  LET GENERATION_ATTEMPTS = 0
  WHILE (KLINGONS_LEFT <= 0) OR (BASES_LEFT <= 0)
    LET GENERATION_ATTEMPTS = GENERATION_ATTEMPTS + 1
    INIT_GALAXY
  ENDWH
  LET KLINGONS_INITIAL = KLINGONS_LEFT
  INIT_QUADRANT
END

DEF PRINT_BRIEFING
  PRINT "STAR TREK MISSION"
  CR
  PRINT "DEADLINE ", DEADLINE, "  KLINGONS ", KLINGONS_INITIAL, "  STARBASES ", BASES_LEFT
  CR
  PRINT_COMMAND_MENU
END

DEF PRINT_COMMAND_HELP
  PRINT "COMMAND MUST BE 0-7"
  CR
END

DEF DISPATCH_COMMAND COMMAND
  SELECT COMMAND
  CASE 0
    DROP
    NAVIGATE
    EVAL 1
  CASE 1
    DROP
    PRINT_SHORT_SCAN
    EVAL 1
  CASE 2
    DROP
    PRINT_LONG_SCAN
    EVAL 1
  CASE 3
    DROP
    PHASER
    EVAL 1
  CASE 4
    DROP
    PHOTON_TORPEDO
    EVAL 1
  CASE 5
    DROP
    SHIELD_CONTROL
    EVAL 1
  CASE 6
    DROP
    DAMAGE_CONTROL
    EVAL 1
  CASE 7
    DROP
    COMPUTER
    EVAL 1
  CASE_ELSE
    DROP
    PRINT_COMMAND_HELP
    EVAL 0
  ENDSEL
END

DEF GAME_LOOP
  WHILE GAME_RESULT = 0
    PRINT "COMMAND (0-7):"
    CR
    IF INPUT?()
      REM I holds the command entered for this game-loop iteration.
      POP_TO I
      IF DISPATCH_COMMAND(I)
        CHECK_ENDGAME
      ENDIF
    ELSE
      DROP
      PRINT "COMMAND INPUT ERROR"
      CR
      PRINT_COMMAND_MENU
    ENDIF
  ENDWH
END

DEF START_GAME
  INIT_MISSION
  CHECK_DOCKING
  PRINT_BRIEFING
  GAME_LOOP
END
