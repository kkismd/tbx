REM STTR1 mission initialization and interactive command loop.

VAR COMMAND
VAR COMMAND_VALID

DEF INIT_MISSION
  LET START_STARDATE = (RND(20) + 19) * 100
  LET STARDATE = START_STARDATE
  LET MISSION_DURATION = 30
  LET DEADLINE = START_STARDATE + MISSION_DURATION
  LET MAX_ENERGY = 3000
  LET ENERGY = MAX_ENERGY
  LET MAX_TORPEDOES = 10
  LET TORPEDOES = MAX_TORPEDOES
  LET SHIELDS = 0
  LET GAME_RESULT = 0
  LET END_REASON = 0
  LET DOCKED = 0
  LET KLINGON_INIT_ENERGY = 200
  LET ENT_QX = RND(8)
  LET ENT_QY = RND(8)
  LET ENT_SX = RND(8)
  LET ENT_SY = RND(8)

  LET @COURSE_DX[1] = 10
  LET @COURSE_DX[2] = 7
  LET @COURSE_DX[3] = 0
  LET @COURSE_DX[4] = -7
  LET @COURSE_DX[5] = -10
  LET @COURSE_DX[6] = -7
  LET @COURSE_DX[7] = 0
  LET @COURSE_DX[8] = 7
  LET @COURSE_DX[9] = 10
  LET @COURSE_DY[1] = 0
  LET @COURSE_DY[2] = -7
  LET @COURSE_DY[3] = -10
  LET @COURSE_DY[4] = -7
  LET @COURSE_DY[5] = 0
  LET @COURSE_DY[6] = 7
  LET @COURSE_DY[7] = 10
  LET @COURSE_DY[8] = 7
  LET @COURSE_DY[9] = 0

  LET KLINGONS_LEFT = 0
  LET BASES_LEFT = 0
  LET GENERATION_ATTEMPTS = 0
  WHILE (KLINGONS_LEFT <= 0) OR (BASES_LEFT <= 0)
    LET GENERATION_ATTEMPTS = GENERATION_ATTEMPTS + 1
    INIT_GALAXY
  ENDWH
  LET KLINGONS_INITIAL = KLINGONS_LEFT
  INIT_QUADRANT
END

DEF PRINT_BRIEFING
  PRINT "STAR TREK MISSION"
  CR
  PRINT "DEADLINE ", DEADLINE, "  KLINGONS ", KLINGONS_INITIAL
  CR
  PRINT "COMMANDS"
  CR
  PRINT "0 NAVIGATE"
  CR
  PRINT "1 SHORT RANGE SCAN"
  CR
  PRINT "2 LONG RANGE SCAN"
  CR
  PRINT "3 PHASER"
  CR
  PRINT "4 PHOTON TORPEDO"
  CR
  PRINT "5 SHIELD CONTROL"
  CR
  PRINT "6 DAMAGE CONTROL"
  CR
  PRINT "7 COMPUTER"
  CR
END

DEF PRINT_COMMAND_HELP
  PRINT "COMMAND MUST BE 0-7"
  CR
END

DEF DISPATCH_COMMAND
  LET COMMAND_VALID = 1
  IF COMMAND = 0
    NAVIGATE
  ELSIF COMMAND = 1
    PRINT_SHORT_SCAN
  ELSIF COMMAND = 2
    PRINT_LONG_SCAN
  ELSIF COMMAND = 3
    PHASER
  ELSIF COMMAND = 4
    PHOTON_TORPEDO
  ELSIF COMMAND = 5
    SHIELD_CONTROL
  ELSIF COMMAND = 6
    DAMAGE_CONTROL
  ELSIF COMMAND = 7
    COMPUTER
  ELSE
    LET COMMAND_VALID = 0
    PRINT_COMMAND_HELP
  ENDIF
END

DEF GAME_LOOP
  WHILE GAME_RESULT = 0
    PRINT "COMMAND (0-7):"
    CR
    LET COMMAND_VALID = 0
    IF INPUT?()
      LET COMMAND = DUP()
      DROP
      DISPATCH_COMMAND
      IF COMMAND_VALID <> 0
        CHECK_ENDGAME
      ENDIF
    ELSE
      DROP
      PRINT "COMMAND INPUT ERROR"
      CR
    ENDIF
  ENDWH
END

DEF START_GAME
  INIT_MISSION
  PRINT_BRIEFING
  GAME_LOOP
END
