DEF INIT_GALAXY
  LET KLINGONS_LEFT = 0
  LET BASES_LEFT = 0
  LET QUADRANT_INDEX = 1
  WHILE QUADRANT_INDEX <= 64
    # I is the short-lived quadrant distribution roll.
    LET I = RND(100)
    IF I <= 80
      LET KLINGONS_HERE = 0
    ELSIF I <= 95
      LET KLINGONS_HERE = 1
    ELSIF I <= 98
      LET KLINGONS_HERE = 2
    ELSE
      LET KLINGONS_HERE = 3
    ENDIF

    LET I = RND(100)
    IF I <= 96
      LET BASES_HERE = 0
    ELSE
      LET BASES_HERE = 1
    ENDIF

    LET STARS_HERE = RND(8)
    LET @GALAXY[QUADRANT_INDEX] = KLINGONS_HERE * 100 + BASES_HERE * 10 + STARS_HERE
    LET KLINGONS_LEFT = KLINGONS_LEFT + KLINGONS_HERE
    LET BASES_LEFT = BASES_LEFT + BASES_HERE
    LET QUADRANT_INDEX = QUADRANT_INDEX + 1
  ENDWH
END

DEF INIT_QUADRANT
  IF ENT_QX < 1 OR ENT_QX > 8 OR ENT_QY < 1 OR ENT_QY > 8
    LET SUMMARY = 0
  ELSE
    LET SUMMARY = @GALAXY[(ENT_QY - 1) * 8 + ENT_QX]
  ENDIF
  LET KLINGONS_HERE = SUMMARY / 100
  LET BASES_HERE = SUMMARY / 10 % 10
  LET STARS_HERE = SUMMARY % 10

  IF KLINGONS_HERE > 0 AND SHIELDS <= 200
    PRINT "COMBAT AREA: SHIELDS DANGEROUSLY LOW"
    CR
  ENDIF

  LET SECTOR_INDEX = 1
  WHILE SECTOR_INDEX <= 64
    LET @SECTOR[SECTOR_INDEX] = 0
    LET SECTOR_INDEX = SECTOR_INDEX + 1
  ENDWH

  LET KLINGON_INDEX = 1
  WHILE KLINGON_INDEX <= 3
    LET @KLINGON_X[KLINGON_INDEX] = 0
    LET @KLINGON_Y[KLINGON_INDEX] = 0
    LET @KLINGON_E[KLINGON_INDEX] = 0
    LET KLINGON_INDEX = KLINGON_INDEX + 1
  ENDWH

  LET @SECTOR[(ENT_SY - 1) * 8 + ENT_SX] = 1

  LET KLINGON_INDEX = 1
  WHILE KLINGON_INDEX <= KLINGONS_HERE
    # I is the short-lived empty-sector index.
    LET I = RND(8) + (RND(8) - 1) * 8
    WHILE @SECTOR[I] <> 0
      LET I = RND(8) + (RND(8) - 1) * 8
    ENDWH
    LET @SECTOR[I] = 2
    LET @KLINGON_X[KLINGON_INDEX] = (I - 1) % 8 + 1
    LET @KLINGON_Y[KLINGON_INDEX] = (I - 1) / 8 + 1
    LET @KLINGON_E[KLINGON_INDEX] = KLINGON_INIT_ENERGY
    LET KLINGON_INDEX = KLINGON_INDEX + 1
  ENDWH

  LET SECTOR_INDEX = 1
  WHILE SECTOR_INDEX <= BASES_HERE
    LET I = RND(8) + (RND(8) - 1) * 8
    WHILE @SECTOR[I] <> 0
      LET I = RND(8) + (RND(8) - 1) * 8
    ENDWH
    LET @SECTOR[I] = 3
    LET SECTOR_INDEX = SECTOR_INDEX + 1
  ENDWH

  LET SECTOR_INDEX = 1
  WHILE SECTOR_INDEX <= STARS_HERE
    LET I = RND(8) + (RND(8) - 1) * 8
    WHILE @SECTOR[I] <> 0
      LET I = RND(8) + (RND(8) - 1) * 8
    ENDWH
    LET @SECTOR[I] = 4
    LET SECTOR_INDEX = SECTOR_INDEX + 1
  ENDWH
END
