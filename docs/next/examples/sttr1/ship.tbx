REM STTR1 shield control, docking, and ship condition.

# Update the user-visible condition code from the current ship state.
# 0 = GREEN, 1 = YELLOW, 2 = RED, 3 = DOCKED.
DEF PRINT_CONDITION
  SELECT CONDITION
    CASE 0
      PRINT "GREEN"
    CASE 1
      PRINT "YELLOW"
    CASE 2
      PRINT "RED"
    CASE_ELSE
      PRINT "DOCKED"
  ENDSEL
END

DEF UPDATE_CONDITION
  IF DOCKED <> 0
    LET CONDITION = 3
  ELSIF KLINGONS_HERE > 0
    LET CONDITION = 2
  ELSIF ENERGY < MAX_ENERGY / 10
    LET CONDITION = 1
  ELSE
    LET CONDITION = 0
  ENDIF
END

# Dock when a starbase occupies one of the eight neighboring sectors.
# A docked ship is replenished immediately and its shields are lowered as in
# the original STTR1 program.  The scan remains responsible for displaying the
# resulting condition; this helper reports a new docking transition while
# keeping repeated checks quiet.
DEF CHECK_DOCKING
  # N holds the previous docked flag only until this check completes.
  LET N = DOCKED
  LET DOCKED = 0
  # I/J visit the 3x3 sector neighborhood; K is its one-based sector index.
  FOR I = ENT_SY - 1 TO ENT_SY + 1
    FOR J = ENT_SX - 1 TO ENT_SX + 1
      IF I >= 1 AND I <= 8 AND J >= 1 AND J <= 8
        LET K = (I - 1) * 8 + J
        IF @SECTOR[K] = 3
          LET DOCKED = 1
        ENDIF
      ENDIF
    NEXT
  NEXT

  IF DOCKED <> 0
    LET ENERGY = MAX_ENERGY
    LET TORPEDOES = MAX_TORPEDOES
    LET SHIELDS = 0
    IF N = 0
      PRINT "DOCKED: ENERGY AND TORPEDOES REPLENISHED; SHIELDS RESET TO 0"
      CR
    ENDIF
  ENDIF
  UPDATE_CONDITION
END

# Transfer total available power between energy and shields.
# A non-positive input cancels; accepted input becomes the complete shield
# value, preserving ENERGY + SHIELDS and rejecting values above that total.
DEF SHIELD_CONTROL
  # Device 7 is shield control.
  IF @DAMAGE[7] < 0
    PRINT "SHIELD CONTROL IS NON-OPERATIONAL"
    CR
    RETURN
  ENDIF
  LET SHIELD_VALID = 0
  WHILE SHIELD_VALID = 0
      PRINT "ENERGY AVAILABLE = ", ENERGY + SHIELDS, " NUMBER OF UNITS TO SHIELDS:"
      CR
      IF_LET SHIELD_ENERGY = TRY_INPUT()
        IF SHIELD_ENERGY <= 0
          LET SHIELD_VALID = 1
          RETURN
        ELSIF SHIELD_ENERGY > ENERGY + SHIELDS
          PRINT "ENERGY EXCEEDED"
          CR
        ELSE
          LET ENERGY = ENERGY + SHIELDS - SHIELD_ENERGY
          LET SHIELDS = SHIELD_ENERGY
          LET SHIELD_VALID = 1
        ENDIF
      LET_ELSE
        PRINT "SHIELD INPUT ERROR"
        CR
      ENDLET
    ENDWH
END
