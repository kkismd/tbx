REM STTR1 mission-state and galaxy initialization.

DIM @GALAXY[64]
DIM @CHART[64]
DIM @DAMAGE[8]
DIM @COURSE_DX[9]
DIM @COURSE_DY[9]
DIM @SECTOR[64]
DIM @KLINGON_X[3]
DIM @KLINGON_Y[3]
DIM @KLINGON_E[3]

VAR START_STARDATE
VAR STARDATE
VAR MISSION_DURATION
VAR DEADLINE
VAR MAX_ENERGY
VAR ENERGY
VAR MAX_TORPEDOES
VAR TORPEDOES
VAR SHIELDS
VAR KLINGON_INIT_ENERGY
VAR ENT_QX
VAR ENT_QY
VAR ENT_SX
VAR ENT_SY
VAR KLINGONS_LEFT
VAR KLINGONS_INITIAL
VAR BASES_LEFT
VAR GENERATION_ATTEMPTS
VAR QUADRANT_INDEX
VAR KLINGONS_HERE
VAR BASES_HERE
VAR STARS_HERE
VAR RANDOM_ROLL
VAR SECTOR_INDEX
VAR SECTOR_ROW
VAR SECTOR_COLUMN
VAR EMPTY_INDEX
VAR KLINGON_INDEX
VAR SUMMARY
VAR COURSE
VAR COURSE_INDEX
VAR COURSE_FRACTION
VAR WARP
VAR WARP_STEPS
VAR DIRECTION_X
VAR DIRECTION_Y
VAR POSITION_X
VAR POSITION_Y
VAR START_POSITION_X
VAR START_POSITION_Y
VAR NEXT_X
VAR NEXT_Y
VAR PREVIOUS_X
VAR PREVIOUS_Y
VAR TARGET_SX
VAR TARGET_SY
VAR TARGET_INDEX
VAR NAVIGATION_VALID
VAR QUADRANT_CROSSED
VAR PHASER_ENERGY
VAR PHASER_VALID
VAR PHASER_DAMAGE
VAR DAMAGE_ROLL
VAR DAMAGE_DISTANCE
VAR DAMAGE_ENERGY_QUOTIENT
VAR DAMAGE_ENERGY_REMAINDER
VAR DAMAGE_PRODUCT
VAR DAMAGE_DENOMINATOR
VAR DAMAGE_QUOTIENT
VAR DAMAGE_REMAINDER
VAR DAMAGE_VALUE
VAR DAMAGE_INDEX
VAR DOCKED

DEF INIT_GALAXY
  LET KLINGONS_LEFT = 0
  LET BASES_LEFT = 0
  LET QUADRANT_INDEX = 1
  WHILE QUADRANT_INDEX <= 64
    LET RANDOM_ROLL = RND(100)
    IF RANDOM_ROLL <= 80
      LET KLINGONS_HERE = 0
    ELSIF RANDOM_ROLL <= 95
      LET KLINGONS_HERE = 1
    ELSIF RANDOM_ROLL <= 98
      LET KLINGONS_HERE = 2
    ELSE
      LET KLINGONS_HERE = 3
    ENDIF

    LET RANDOM_ROLL = RND(100)
    IF RANDOM_ROLL <= 96
      LET BASES_HERE = 0
    ELSE
      LET BASES_HERE = 1
    ENDIF

    LET STARS_HERE = RND(8)
    LET @GALAXY[QUADRANT_INDEX] = KLINGONS_HERE * 100 + BASES_HERE * 10 + STARS_HERE
    LET KLINGONS_LEFT = KLINGONS_LEFT + KLINGONS_HERE
    LET BASES_LEFT = BASES_LEFT + BASES_HERE
    LET QUADRANT_INDEX = QUADRANT_INDEX + 1
  ENDWH
END

DEF INIT_QUADRANT
  IF ENT_QX < 1 OR ENT_QX > 8 OR ENT_QY < 1 OR ENT_QY > 8
    LET SUMMARY = 0
  ELSE
    LET SUMMARY = @GALAXY[(ENT_QY - 1) * 8 + ENT_QX]
  ENDIF
  LET KLINGONS_HERE = SUMMARY / 100
  LET BASES_HERE = SUMMARY / 10 % 10
  LET STARS_HERE = SUMMARY % 10

  LET SECTOR_INDEX = 1
  WHILE SECTOR_INDEX <= 64
    LET @SECTOR[SECTOR_INDEX] = 0
    LET SECTOR_INDEX = SECTOR_INDEX + 1
  ENDWH

  LET KLINGON_INDEX = 1
  WHILE KLINGON_INDEX <= 3
    LET @KLINGON_X[KLINGON_INDEX] = 0
    LET @KLINGON_Y[KLINGON_INDEX] = 0
    LET @KLINGON_E[KLINGON_INDEX] = 0
    LET KLINGON_INDEX = KLINGON_INDEX + 1
  ENDWH

  LET @SECTOR[(ENT_SY - 1) * 8 + ENT_SX] = 1

  LET KLINGON_INDEX = 1
  WHILE KLINGON_INDEX <= KLINGONS_HERE
    LET EMPTY_INDEX = RND(8) + (RND(8) - 1) * 8
    WHILE @SECTOR[EMPTY_INDEX] <> 0
      LET EMPTY_INDEX = RND(8) + (RND(8) - 1) * 8
    ENDWH
    LET @SECTOR[EMPTY_INDEX] = 2
    LET @KLINGON_X[KLINGON_INDEX] = (EMPTY_INDEX - 1) % 8 + 1
    LET @KLINGON_Y[KLINGON_INDEX] = (EMPTY_INDEX - 1) / 8 + 1
    LET @KLINGON_E[KLINGON_INDEX] = KLINGON_INIT_ENERGY
    LET KLINGON_INDEX = KLINGON_INDEX + 1
  ENDWH

  LET SECTOR_INDEX = 1
  WHILE SECTOR_INDEX <= BASES_HERE
    LET EMPTY_INDEX = RND(8) + (RND(8) - 1) * 8
    WHILE @SECTOR[EMPTY_INDEX] <> 0
      LET EMPTY_INDEX = RND(8) + (RND(8) - 1) * 8
    ENDWH
    LET @SECTOR[EMPTY_INDEX] = 3
    LET SECTOR_INDEX = SECTOR_INDEX + 1
  ENDWH

  LET SECTOR_INDEX = 1
  WHILE SECTOR_INDEX <= STARS_HERE
    LET EMPTY_INDEX = RND(8) + (RND(8) - 1) * 8
    WHILE @SECTOR[EMPTY_INDEX] <> 0
      LET EMPTY_INDEX = RND(8) + (RND(8) - 1) * 8
    ENDWH
    LET @SECTOR[EMPTY_INDEX] = 4
    LET SECTOR_INDEX = SECTOR_INDEX + 1
  ENDWH
END

DEF NAVIGATE
  LET NAVIGATION_VALID = 0
  WHILE NAVIGATION_VALID = 0
    PRINT "COURSE (0 CANCEL, 10-89):"
    CR
    IF INPUT?()
      LET COURSE = DUP()
      DROP
      IF COURSE = 0
        LET NAVIGATION_VALID = 1
      ELSIF COURSE >= 10 AND COURSE <= 89
        PRINT "WARP (0-80):"
        CR
        IF INPUT?()
          LET WARP = DUP()
          DROP
          IF WARP >= 0 AND WARP <= 80
            IF @DAMAGE[1] < 0 AND WARP > 2
              PRINT "WARP ENGINES ARE DAMAGED, MAXIMUM SPEED = WARP .2"
              CR
            ELSE
              LET NAVIGATION_VALID = 1
            ENDIF
          ELSE
            PRINT "WARP OUT OF RANGE"
            CR
          ENDIF
        ELSE
          DROP
          PRINT "WARP INPUT ERROR"
          CR
        ENDIF
      ELSE
        PRINT "COURSE OUT OF RANGE"
        CR
      ENDIF
    ELSE
      DROP
      PRINT "COURSE INPUT ERROR"
      CR
    ENDIF
  ENDWH

  IF COURSE <> 0
    LET COURSE_INDEX = COURSE / 10
    LET COURSE_FRACTION = COURSE % 10
    LET DIRECTION_X = (@COURSE_DX[COURSE_INDEX] * (10 - COURSE_FRACTION) + @COURSE_DX[COURSE_INDEX + 1] * COURSE_FRACTION) / 10
    LET DIRECTION_Y = (@COURSE_DY[COURSE_INDEX] * (10 - COURSE_FRACTION) + @COURSE_DY[COURSE_INDEX + 1] * COURSE_FRACTION) / 10
    LET WARP_STEPS = WARP * 8 / 10
    LET POSITION_X = ENT_SX * 10
    LET POSITION_Y = ENT_SY * 10
    LET START_POSITION_X = POSITION_X
    LET START_POSITION_Y = POSITION_Y
    LET QUADRANT_CROSSED = 0
    LET NAVIGATION_VALID = 0

    WHILE NAVIGATION_VALID < WARP_STEPS
    LET PREVIOUS_X = POSITION_X
    LET PREVIOUS_Y = POSITION_Y
    LET NEXT_X = POSITION_X + DIRECTION_X
    LET NEXT_Y = POSITION_Y + DIRECTION_Y

    IF NEXT_X >= 5 AND NEXT_X <= 84 AND NEXT_Y >= 5 AND NEXT_Y <= 84
      LET TARGET_SX = (NEXT_X + 5) / 10
      LET TARGET_SY = (NEXT_Y + 5) / 10
      LET TARGET_INDEX = (TARGET_SY - 1) * 8 + TARGET_SX
      IF @SECTOR[TARGET_INDEX] <> 0
        LET POSITION_X = PREVIOUS_X
        LET POSITION_Y = PREVIOUS_Y
        LET NAVIGATION_VALID = WARP_STEPS
      ELSE
        LET @SECTOR[(ENT_SY - 1) * 8 + ENT_SX] = 0
        LET POSITION_X = NEXT_X
        LET POSITION_Y = NEXT_Y
        LET ENT_SX = TARGET_SX
        LET ENT_SY = TARGET_SY
        LET @SECTOR[TARGET_INDEX] = 1
        LET NAVIGATION_VALID = NAVIGATION_VALID + 1
      ENDIF
    ELSE
      # Crossing follows the original program: calculate the final position
      # from the starting sector and the complete planned distance, then
      # build only the final quadrant.
      LET POSITION_X = START_POSITION_X + DIRECTION_X * WARP_STEPS
      LET POSITION_Y = START_POSITION_Y + DIRECTION_Y * WARP_STEPS
      WHILE POSITION_X < 5
        LET ENT_QX = ENT_QX - 1
        LET POSITION_X = POSITION_X + 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE POSITION_X >= 85
        LET ENT_QX = ENT_QX + 1
        LET POSITION_X = POSITION_X - 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE POSITION_Y < 5
        LET ENT_QY = ENT_QY - 1
        LET POSITION_Y = POSITION_Y + 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      WHILE POSITION_Y >= 85
        LET ENT_QY = ENT_QY + 1
        LET POSITION_Y = POSITION_Y - 80
        LET QUADRANT_CROSSED = 1
      ENDWH
      LET ENT_SX = (POSITION_X + 5) / 10
      LET ENT_SY = (POSITION_Y + 5) / 10
      INIT_QUADRANT
      LET NAVIGATION_VALID = WARP_STEPS
    ENDIF
    ENDWH

    LET ENERGY = ENERGY - WARP_STEPS + 5
    IF QUADRANT_CROSSED <> 0 OR WARP >= 10
      LET STARDATE = STARDATE + 1
    ENDIF
  ENDIF
END

DEF PRINT_SHORT_SCAN
  IF @DAMAGE[2] < 0
    PRINT "SHORT RANGE SENSORS INOPERABLE"
    CR
  ELSE
    PRINT "SHORT RANGE SCAN"
    CR
    LET SECTOR_ROW = 1
    WHILE SECTOR_ROW <= 8
      LET SECTOR_COLUMN = 1
      WHILE SECTOR_COLUMN <= 8
        LET SECTOR_INDEX = (SECTOR_ROW - 1) * 8 + SECTOR_COLUMN
        IF @SECTOR[SECTOR_INDEX] = 0
          PRINT "."
        ELSIF @SECTOR[SECTOR_INDEX] = 1
          PRINT "P"
        ELSIF @SECTOR[SECTOR_INDEX] = 2
          PRINT "K"
        ELSIF @SECTOR[SECTOR_INDEX] = 3
          PRINT "B"
        ELSE
          PRINT "*"
        ENDIF
        LET SECTOR_COLUMN = SECTOR_COLUMN + 1
      ENDWH
      CR
      LET SECTOR_ROW = SECTOR_ROW + 1
    ENDWH
    PRINT "STATUS ", STARDATE, " ", ENT_QX, " ", ENT_QY, " ", ENT_SX, " ", ENT_SY, " ", ENERGY, " ", TORPEDOES, " ", SHIELDS
    CR
  ENDIF
END

DEF PRINT_LONG_SCAN
  IF @DAMAGE[3] < 0
    PRINT "LONG RANGE SENSORS INOPERABLE"
    CR
  ELSE
    PRINT "LONG RANGE SCAN"
    CR
    LET SECTOR_ROW = ENT_QY - 1
    WHILE SECTOR_ROW <= ENT_QY + 1
      LET SECTOR_COLUMN = ENT_QX - 1
      WHILE SECTOR_COLUMN <= ENT_QX + 1
        IF SECTOR_ROW < 1 OR SECTOR_ROW > 8 OR SECTOR_COLUMN < 1 OR SECTOR_COLUMN > 8
          PRINT "---"
        ELSE
          LET SUMMARY = @GALAXY[(SECTOR_ROW - 1) * 8 + SECTOR_COLUMN]
          PRINT SUMMARY, " "
          IF @DAMAGE[7] >= 0
            LET @CHART[(SECTOR_ROW - 1) * 8 + SECTOR_COLUMN] = SUMMARY
          ENDIF
        ENDIF
        LET SECTOR_COLUMN = SECTOR_COLUMN + 1
      ENDWH
      CR
      LET SECTOR_ROW = SECTOR_ROW + 1
    ENDWH
  ENDIF
END

# Return the integer square root of a non-negative value.  Combat uses this
# small TBX helper instead of adding a combat-specific VM primitive.
DEF ISQRT VALUE
  LET DAMAGE_VALUE = 0
  WHILE (DAMAGE_VALUE + 1) * (DAMAGE_VALUE + 1) <= VALUE
    LET DAMAGE_VALUE = DAMAGE_VALUE + 1
  ENDWH
  DROP
  EVAL DAMAGE_VALUE
END

# Return distance in tenths of a sector between Enterprise and Klingon INDEX.
DEF DIST_TO_KLINGON INDEX
  LET DAMAGE_VALUE = (@KLINGON_X[INDEX] - ENT_SX) * (@KLINGON_X[INDEX] - ENT_SX) + (@KLINGON_Y[INDEX] - ENT_SY) * (@KLINGON_Y[INDEX] - ENT_SY)
  LET DAMAGE_VALUE = ISQRT(DAMAGE_VALUE * 100)
  DROP
  EVAL DAMAGE_VALUE
END

# Calculate floor(ENERGY * ROLL * 10 / (DISTANCE10 * DIVISOR * 100)) without
# constructing an overflowing product.  ROLL is the 0..199 scale-100 value.
DEF COMBAT_DAMAGE ENERGY, ROLL, DISTANCE10, DIVISOR
  LET DAMAGE_ENERGY_QUOTIENT = ENERGY / 100
  LET DAMAGE_ENERGY_REMAINDER = ENERGY % 100
  LET DAMAGE_PRODUCT = DAMAGE_ENERGY_QUOTIENT * ROLL + DAMAGE_ENERGY_REMAINDER * ROLL / 100
  LET DAMAGE_DENOMINATOR = DISTANCE10 * DIVISOR
  LET DAMAGE_QUOTIENT = DAMAGE_PRODUCT / DAMAGE_DENOMINATOR
  LET DAMAGE_REMAINDER = DAMAGE_PRODUCT % DAMAGE_DENOMINATOR
  LET DAMAGE_VALUE = DAMAGE_QUOTIENT * 10 + DAMAGE_REMAINDER * 10 / DAMAGE_DENOMINATOR
  DROP
  DROP
  DROP
  DROP
  EVAL DAMAGE_VALUE
END

DEF DESTROY_KLINGON INDEX
  LET DAMAGE_INDEX = (@KLINGON_Y[INDEX] - 1) * 8 + @KLINGON_X[INDEX]
  LET @SECTOR[DAMAGE_INDEX] = 0
  LET @KLINGON_E[INDEX] = 0
  LET KLINGONS_HERE = KLINGONS_HERE - 1
  LET KLINGONS_LEFT = KLINGONS_LEFT - 1
  IF ENT_QX >= 1 AND ENT_QX <= 8 AND ENT_QY >= 1 AND ENT_QY <= 8
    LET @GALAXY[(ENT_QY - 1) * 8 + ENT_QX] = KLINGONS_HERE * 100 + BASES_HERE * 10 + STARS_HERE
  ENDIF
  DROP
END

DEF KLINGON_ATTACK
  IF DOCKED = 0
    LET KLINGON_INDEX = 1
    WHILE KLINGON_INDEX <= 3
      IF @KLINGON_E[KLINGON_INDEX] > 0
        LET DAMAGE_DISTANCE = DIST_TO_KLINGON(KLINGON_INDEX)
        LET DAMAGE_ROLL = RND(200) - 1
        LET DAMAGE_VALUE = COMBAT_DAMAGE(@KLINGON_E[KLINGON_INDEX], DAMAGE_ROLL, DAMAGE_DISTANCE, 1)
        LET SHIELDS = SHIELDS - DAMAGE_VALUE
      ENDIF
      LET KLINGON_INDEX = KLINGON_INDEX + 1
    ENDWH
  ENDIF
END

DEF PHASER
  IF KLINGONS_HERE = 0
    PRINT "NO KLINGONS IN THIS QUADRANT"
    CR
  ELSIF @DAMAGE[4] < 0
    PRINT "PHASER CONTROL IS NON-OPERATIONAL"
    CR
  ELSE
    LET PHASER_ENERGY = 0
    LET PHASER_VALID = 0
    WHILE PHASER_VALID = 0
      PRINT "PHASER ENERGY:"
      CR
      IF INPUT?()
        LET PHASER_ENERGY = DUP()
        DROP
        IF PHASER_ENERGY <= 0
          LET PHASER_ENERGY = 0
          LET PHASER_VALID = 1
        ELSIF PHASER_ENERGY > ENERGY
          PRINT "ENERGY EXCEEDED"
          CR
          LET PHASER_ENERGY = 0
        ELSE
          LET PHASER_VALID = 1
        ENDIF
      ELSE
        DROP
        PRINT "PHASER INPUT ERROR"
        CR
      ENDIF
    ENDWH

    IF PHASER_ENERGY > 0
      LET ENERGY = ENERGY - PHASER_ENERGY
      KLINGON_ATTACK
    ENDIF
    IF PHASER_ENERGY > 0 AND SHIELDS >= 0
      # STTR1 uses damage slot 7 for computer accuracy despite its device
      # table naming; device-index cleanup is handled by a later milestone.
      IF @DAMAGE[7] < 0
        LET DAMAGE_ROLL = RND(100) - 1
        LET PHASER_ENERGY = (PHASER_ENERGY / 100) * DAMAGE_ROLL + (PHASER_ENERGY % 100) * DAMAGE_ROLL / 100
      ENDIF
      LET KLINGON_INDEX = 1
      WHILE KLINGON_INDEX <= 3
        IF @KLINGON_E[KLINGON_INDEX] > 0
          LET DAMAGE_DISTANCE = DIST_TO_KLINGON(KLINGON_INDEX)
          LET DAMAGE_ROLL = RND(200) - 1
          LET PHASER_DAMAGE = COMBAT_DAMAGE(PHASER_ENERGY, DAMAGE_ROLL, DAMAGE_DISTANCE, KLINGONS_HERE)
          LET @KLINGON_E[KLINGON_INDEX] = @KLINGON_E[KLINGON_INDEX] - PHASER_DAMAGE
          IF @KLINGON_E[KLINGON_INDEX] <= 0
            DESTROY_KLINGON(KLINGON_INDEX)
          ENDIF
        ENDIF
        LET KLINGON_INDEX = KLINGON_INDEX + 1
      ENDWH
    ENDIF
  ENDIF
END

LET START_STARDATE = (RND(20) + 19) * 100
LET STARDATE = START_STARDATE
LET MISSION_DURATION = 30
LET DEADLINE = START_STARDATE + MISSION_DURATION
LET MAX_ENERGY = 3000
LET ENERGY = MAX_ENERGY
LET MAX_TORPEDOES = 10
LET TORPEDOES = MAX_TORPEDOES
LET SHIELDS = 0
LET DOCKED = 0
LET KLINGON_INIT_ENERGY = 200
LET ENT_QX = RND(8)
LET ENT_QY = RND(8)
LET ENT_SX = RND(8)
LET ENT_SY = RND(8)

PACK @COURSE_DX = 10, 7, 0, -7, -10, -7, 0, 7, 10
PACK @COURSE_DY = 0, -7, -10, -7, 0, 7, 10, 7, 0

LET KLINGONS_LEFT = 0
LET BASES_LEFT = 0
LET GENERATION_ATTEMPTS = 0
WHILE (KLINGONS_LEFT <= 0) OR (BASES_LEFT <= 0)
  LET GENERATION_ATTEMPTS = GENERATION_ATTEMPTS + 1
  INIT_GALAXY
ENDWH
LET KLINGONS_INITIAL = KLINGONS_LEFT

INIT_QUADRANT

PRINT "MISSION ", START_STARDATE, " ", STARDATE, " ", MISSION_DURATION, " ", DEADLINE, " ", MAX_ENERGY, " ", ENERGY, " ", MAX_TORPEDOES, " ", TORPEDOES, " ", SHIELDS, " ", KLINGON_INIT_ENERGY, " ", ENT_QX, " ", ENT_QY, " ", ENT_SX, " ", ENT_SY
CR
PRINT "TOTALS ", KLINGONS_LEFT, " ", KLINGONS_INITIAL, " ", BASES_LEFT, " ", GENERATION_ATTEMPTS
CR

PRINT "QUADRANT ", ENT_QX, " ", ENT_QY, " ", KLINGONS_HERE, " ", BASES_HERE, " ", STARS_HERE
CR

PRINT "KLINGON_STATE "
LET KLINGON_INDEX = 1
WHILE KLINGON_INDEX <= 3
  PRINT @KLINGON_X[KLINGON_INDEX], " ", @KLINGON_Y[KLINGON_INDEX], " ", @KLINGON_E[KLINGON_INDEX], " "
  LET KLINGON_INDEX = KLINGON_INDEX + 1
ENDWH
CR

PRINT_SHORT_SCAN
PRINT_LONG_SCAN

PRINT "GALAXY "
LET QUADRANT_INDEX = 1
WHILE QUADRANT_INDEX <= 64
  PRINT @GALAXY[QUADRANT_INDEX], " "
  LET QUADRANT_INDEX = QUADRANT_INDEX + 1
ENDWH
CR

PRINT "CHART "
LET QUADRANT_INDEX = 1
WHILE QUADRANT_INDEX <= 64
  PRINT @CHART[QUADRANT_INDEX], " "
  LET QUADRANT_INDEX = QUADRANT_INDEX + 1
ENDWH
CR

PRINT "DAMAGE "
LET QUADRANT_INDEX = 1
WHILE QUADRANT_INDEX <= 8
  PRINT @DAMAGE[QUADRANT_INDEX], " "
  LET QUADRANT_INDEX = QUADRANT_INDEX + 1
ENDWH
CR

PRINT "COURSE_DX "
LET QUADRANT_INDEX = 1
WHILE QUADRANT_INDEX <= 9
  PRINT @COURSE_DX[QUADRANT_INDEX], " "
  LET QUADRANT_INDEX = QUADRANT_INDEX + 1
ENDWH
CR

PRINT "COURSE_DY "
LET QUADRANT_INDEX = 1
WHILE QUADRANT_INDEX <= 9
  PRINT @COURSE_DY[QUADRANT_INDEX], " "
  LET QUADRANT_INDEX = QUADRANT_INDEX + 1
ENDWH
CR
