REM Guess the number selected by RND(100).

VAR ANSWER
VAR DONE

LET ANSWER = RND(100)
LET DONE = 0

WHILE DONE = 0
  PRINT "Guess a number from 1 to 100: "
  IF INPUT?()
    IF DUP() < ANSWER
      PRINT "Too low."
      CR
      DROP
    ELSIF DUP() > ANSWER
      PRINT "Too high."
      CR
      DROP
    ELSE
      PRINT "Correct!"
      CR
      DROP
      LET DONE = 1
    ENDIF
  ELSE
    DROP
    PRINT "Please enter a number."
    CR
  ENDIF
WEND
