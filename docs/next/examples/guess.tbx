REM Guess the number selected by RND(100).

VAR ANSWER
VAR DONE
VAR GUESS

LET ANSWER = RND(100)
LET DONE = 0

WHILE DONE = 0
  PRINT "Guess a number from 1 to 100: "
  IF_LET GUESS = TRY_INPUT()
    IF GUESS < ANSWER
      PRINT "Too low."
      CR
    ELSIF GUESS > ANSWER
      PRINT "Too high."
      CR
    ELSE
      PRINT "Correct!"
      CR
      LET DONE = 1
    ENDIF
  LET_ELSE
    PRINT "Please enter a number."
    CR
  ENDLET
ENDWH
