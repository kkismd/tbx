SYNTAX IF
  BLOCK
  START
    READ_EXPR AS condition
    EMIT_EXPR condition
    EMIT_BRANCH_IF_FALSE_FOLLOWING
  MARK_ANY ELSIF
    EMIT_BRANCH_COMPLETE
    PATCH_FOLLOWING
    READ_EXPR AS elsif_condition
    EMIT_EXPR elsif_condition
    EMIT_BRANCH_IF_FALSE_FOLLOWING
  MARK_OPTIONAL ELSE
    EMIT_BRANCH_COMPLETE
    PATCH_FOLLOWING
    EXPECT_END
  LAST ENDIF
    EXPECT_END
    PATCH_FOLLOWING
    PATCH_COMPLETE
ENDS

SYNTAX WHILE
  BLOCK EXIT_TARGET
  START
    POSITION AS loop_start
    READ_EXPR AS condition
    EMIT_EXPR condition
    EMIT_BRANCH_IF_FALSE_COMPLETE
  LAST ENDWH
    EXPECT_END
    EMIT_BRANCH loop_start
ENDS

SYNTAX DO
  BLOCK EXIT_TARGET
  START
    POSITION AS loop_start
  LAST UNTIL
    READ_EXPR AS condition
    EXPECT_END
    EMIT_EXPR condition
    EMIT_BRANCH_IF_FALSE loop_start
ENDS

SYNTAX FOR
  BLOCK EXIT_TARGET
  START
    RESOLVE_WORD_LITERAL LESS_EQUAL? AS less_equal
    RESOLVE_WORD_LITERAL ADD AS add
    READ_NAME AS variable_name
    RESOLVE_VAR variable_name AS variable
    EXPECT "="
    READ_EXPR_UNTIL_NAME TO AS start
    EXPECT_NAME TO
    READ_EXPR AS end
    EMIT_EXPR start
    EMIT_EXPR end
    EMIT_CONTROL_PUSH
    EMIT_STORE variable
    POSITION AS loop_start
    EMIT_LOAD variable
    EMIT_CONTROL_COPY
    EMIT_CALL less_equal
    EMIT_BRANCH_IF_FALSE_FOLLOWING
  LAST NEXT
    EXPECT_END
    EMIT_LOAD variable
    EMIT_INT 1
    EMIT_CALL add
    EMIT_STORE variable
    EMIT_BRANCH loop_start
    PATCH_FOLLOWING
    EMIT_CONTROL_DROP
ENDS

SYNTAX SELECT
  BLOCK
  START
    READ_EXPR AS selector
    EXPECT_END
    EMIT_EXPR selector
    EMIT_CONTROL_PUSH
    RESOLVE_WORD_LITERAL EQUAL? AS equal
  MARK_SOME CASE
    READ_EXPR AS case_expr
    EXPECT_END
    EMIT_BRANCH_COMPLETE_IF_FOLLOWING
    PATCH_FOLLOWING
    EMIT_CONTROL_COPY
    EMIT_EXPR case_expr
    EMIT_CALL equal
    EMIT_BRANCH_IF_FALSE_FOLLOWING
  MARK_OPTIONAL CASE_ELSE
    EXPECT_END
    EMIT_BRANCH_COMPLETE_IF_FOLLOWING
    PATCH_FOLLOWING
  LAST ENDSEL
    EMIT_BRANCH_COMPLETE_IF_FOLLOWING
    PATCH_FOLLOWING
    PATCH_COMPLETE
    EMIT_CONTROL_DROP
ENDS
