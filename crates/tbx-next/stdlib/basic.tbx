SYNTAX WHILE
BLOCK
START
POSITION AS loop_start
READ_EXPR AS condition
EMIT_EXPR condition
EMIT_BRANCH_IF_FALSE_COMPLETE
LAST ENDWH
EXPECT_END
EMIT_BRANCH loop_start
ENDS

SYNTAX DO
BLOCK
START
POSITION AS loop_start
LAST UNTIL
READ_EXPR AS condition
EXPECT_END
EMIT_EXPR condition
EMIT_BRANCH_IF_FALSE loop_start
ENDS

SYNTAX SELECT
BLOCK
START
READ_EXPR AS selector
EXPECT_END
EMIT_EXPR selector
EMIT_CONTROL_PUSH
RESOLVE_WORD_LITERAL EQUAL? AS equal
MARK_SOME CASE
READ_EXPR AS case_expr
EXPECT_END
EMIT_BRANCH_COMPLETE_IF_FOLLOWING
PATCH_FOLLOWING
EMIT_CONTROL_COPY
EMIT_EXPR case_expr
EMIT_CALL equal
EMIT_BRANCH_IF_FALSE_FOLLOWING
MARK_OPTIONAL CASE_ELSE
EXPECT_END
EMIT_BRANCH_COMPLETE_IF_FOLLOWING
PATCH_FOLLOWING
LAST ENDSEL
EMIT_BRANCH_COMPLETE_IF_FOLLOWING
PATCH_FOLLOWING
PATCH_COMPLETE
EMIT_CONTROL_DROP
ENDS
