REM M21 standard-library and source-word binary E2E fixture
SYNTAX SLET
STATEMENT
READ_NAME AS name
RESOLVE_VAR name AS target
EXPECT "="
READ_EXPR AS expr
EMIT_EXPR expr
EMIT_STORE target
ENDS

SLET A = 0
LET B = 0
IF 0
LET B = 99
ELSIF 1
WHILE A < 2
DO
LET B = B + 1
UNTIL B >= 2
LET A = A + 1
ENDWH
ELSE
LET B = 98
ENDIF
PUTDEC A
CR

LET A = 0
WHILE 1
LET A = A + 1
BREAK
LET A = A + 100
ENDWH
PUTDEC A
CR

DO
LET A = A + 1
BREAK
UNTIL 1
PUTDEC A
CR

FOR I = 1 TO 1
SELECT I
CASE 1
BREAK
ENDSEL
NEXT
PUTDEC I
CR
PUTDEC B
CR

LET A = 0
DO
LET B = 0
WHILE B < 2
LET B = B + 1
ENDWH
LET A = A + 1
UNTIL A >= 2
PUTDEC A
CR
