REM M21 standard-library and source-word binary E2E fixture
SYNTAX SLET
STATEMENT
READ_NAME AS name
RESOLVE_VAR name AS target
EXPECT "="
READ_EXPR AS expr
EMIT_EXPR expr
EMIT_STORE target
ENDS

VAR ITERATION
VAR COUNT
VAR LOOP_INDEX
SLET ITERATION = 0
LET COUNT = 0
IF 0
LET COUNT = 99
ELSIF 1
WHILE ITERATION < 2
DO
LET COUNT = COUNT + 1
UNTIL COUNT >= 2
LET ITERATION = ITERATION + 1
ENDWH
ELSE
LET COUNT = 98
ENDIF
PUTDEC ITERATION
CR

LET ITERATION = 0
WHILE 1
LET ITERATION = ITERATION + 1
BREAK
LET ITERATION = ITERATION + 100
ENDWH
PUTDEC ITERATION
CR

DO
LET ITERATION = ITERATION + 1
BREAK
UNTIL 1
PUTDEC ITERATION
CR

FOR LOOP_INDEX = 1 TO 1
SELECT LOOP_INDEX
CASE 1
BREAK
ENDSEL
NEXT
PUTDEC LOOP_INDEX
CR
PUTDEC COUNT
CR

LET ITERATION = 0
DO
LET COUNT = 0
WHILE COUNT < 2
LET COUNT = COUNT + 1
ENDWH
LET ITERATION = ITERATION + 1
UNTIL ITERATION >= 2
PUTDEC ITERATION
CR
