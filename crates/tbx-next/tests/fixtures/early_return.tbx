LET A = 0

DEF RETURN_IF
  IF 1
    RETURN
  ENDIF
  LET A = A + 100
END

DEF RETURN_WHILE
  WHILE 1
    RETURN
  ENDWH
  LET A = A + 100
END

DEF RETURN_DO
  DO
    RETURN
  UNTIL 0
  LET A = A + 100
END

DEF RETURN_FOR
  FOR I = 1 TO 3
    RETURN
  NEXT
  LET A = 99
END

DEF RETURN_SELECT
  SELECT 1
  CASE 1
    RETURN
  ENDSEL
  LET A = A + 100
END

DEF RETURN_INNER
  RETURN
  LET A = A + 100
END

DEF RETURN_OUTER
  RETURN_INNER
  LET A = A + 10
END

RETURN_IF
RETURN_WHILE
RETURN_DO
RETURN_FOR
RETURN_SELECT
RETURN_OUTER
LET A = A + 1
PUTDEC A
CR
PUTDEC I
CR
