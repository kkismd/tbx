VAR SCORE
VAR LOOP_INDEX
LET SCORE = 0

DEF RETURN_IF
  IF 1
    RETURN
  ENDIF
  LET SCORE = SCORE + 100
END

DEF RETURN_WHILE
  WHILE 1
    RETURN
  ENDWH
  LET SCORE = SCORE + 100
END

DEF RETURN_DO
  DO
    RETURN
  UNTIL 0
  LET SCORE = SCORE + 100
END

DEF RETURN_FOR
  FOR LOOP_INDEX = 1 TO 3
    RETURN
  NEXT
  LET SCORE = 99
END

DEF RETURN_SELECT
  SELECT 1
  CASE 1
    RETURN
  ENDSEL
  LET SCORE = SCORE + 100
END

DEF RETURN_INNER
  RETURN
  LET SCORE = SCORE + 100
END

DEF RETURN_OUTER
  RETURN_INNER
  LET SCORE = SCORE + 10
END

RETURN_IF
RETURN_WHILE
RETURN_DO
RETURN_FOR
RETURN_SELECT
RETURN_OUTER
LET SCORE = SCORE + 1
PUTDEC SCORE
CR
PUTDEC LOOP_INDEX
CR
