REM A disconnected exit exercises the exhausted-stack result.
DIM @MAZE[25]
DIM @VISITED[25]
DIM @STACK_X[25]
DIM @STACK_Y[25]
DIM @STACK_NEXT[25]

VAR WIDTH
VAR HEIGHT
VAR INDEX
VAR TURN
VAR DIRECTION
VAR CANDIDATE_X
VAR CANDIDATE_Y
VAR DEPTH
VAR FOUND
VAR DONE

LET WIDTH = 5
LET HEIGHT = 5
LET @MAZE[7] = 1
LET @MAZE[9] = 1
LET X = 2
LET Y = 2
LET @VISITED[7] = 1
LET TURN = 1

WHILE DONE = 0
  IF X = 4 AND Y = 2
    LET FOUND = 1
    LET DONE = 1
  ELSE
    IF TURN <= 4
      LET DIRECTION = TURN
      LET TURN = TURN + 1
      LET CANDIDATE_X = X
      LET CANDIDATE_Y = Y
      IF DIRECTION = 1
        LET CANDIDATE_Y = Y + 1
      ELSIF DIRECTION = 2
        LET CANDIDATE_X = X + 1
      ELSIF DIRECTION = 3
        LET CANDIDATE_Y = Y - 1
      ELSE
        LET CANDIDATE_X = X - 1
      ENDIF
      IF CANDIDATE_X >= 1 AND CANDIDATE_X <= WIDTH AND CANDIDATE_Y >= 1 AND CANDIDATE_Y <= HEIGHT
        LET INDEX = (CANDIDATE_Y - 1) * WIDTH + CANDIDATE_X
        IF @MAZE[INDEX] <> 0 AND @VISITED[INDEX] = 0
          LET DEPTH = DEPTH + 1
          LET @STACK_X[DEPTH] = X
          LET @STACK_Y[DEPTH] = Y
          LET @STACK_NEXT[DEPTH] = TURN
          LET X = CANDIDATE_X
          LET Y = CANDIDATE_Y
          LET @VISITED[INDEX] = 1
          LET TURN = 1
        ENDIF
      ENDIF
    ELSE
      IF DEPTH = 0
        LET DONE = 1
      ELSE
        LET X = @STACK_X[DEPTH]
        LET Y = @STACK_Y[DEPTH]
        LET TURN = @STACK_NEXT[DEPTH]
        LET DEPTH = DEPTH - 1
      ENDIF
    ENDIF
  ENDIF
ENDWH

IF FOUND = 1
  PRINT "MAZE SOLVED"
ELSE
  PRINT "NO PATH"
ENDIF
CR
