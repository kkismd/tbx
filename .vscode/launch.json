{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TBX Next Syntax Highlight",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode-tbx-next",
        "${workspaceFolder}"
      ]
    }
  ]
}
